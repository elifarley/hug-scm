#!/usr/bin/env bash
_hug_category='["working-dir"]'
test "${1:-}" = '--search-meta' && {
  printf 'category = %s\n' "$_hug_category"
  exit 0
}
CMD_BASE="$(readlink -f "$0" 2> /dev/null || greadlink -f "$0")" || CMD_BASE="$0"
CMD_BASE="$(dirname "$CMD_BASE")"
for f in hug-common hug-git-kit; do . "$CMD_BASE/../lib/$f"; done # Load common constants and functions
set -euo pipefail                                                 # Exit on error, undefined vars, pipe failures

# Part of the Hug tool suite

show_help() {
  cat << EOF
w-get: Get file contents from specific commit (without staging)

USAGE:
    hug w get [-f/--force] <target> [file1] [file2] ...
    hug w get [-f/--force] <target> --
    hug w get [-f/--force] <target> --browse-root
    hug w get [-f/--force] -u [file1] [file2] ...

OPTIONS:
    -f, --force     Force overwrite, ignoring any uncommitted changes and running non-interactively.
    -y, --yes       Has NO effect on the clean path (which needs no flag) and does NOT
                    override the dirty-path refusal — only -f/--force overwrites
                    uncommitted changes. (Routine-confirm flag; not a force substitute.)
    -u, --upstream  Use the head of the upstream branch as the target commit.
                    With no files given, resets ALL files (see EXAMPLES).
                    NOTE: files named like a branch, tag, or 1-2 digit number are
                    rejected under -u (mistyped-target guard); use the non -u form
                    or pass ./<name> for such files.
    --dry-run       Preview what would be reset without making any changes.
    --browse-root   Browse full repository scope in file selector UI (default: current directory)
    <target>        Either an integer 0 <= N < 100 or a COMMIT hash
        N               Specifies how many commits to go back from a file's last change.
                        N=0 resets to the file's state in HEAD.
                        N=1 resets to its state before the last change.
                        N=2 resets to its state before the second-to-last change.
        COMMIT          Target commit hash, branch, or reference.
    [file...]       Specific files to reset (optional)
                    If omitted, ALL files will be reset.
    --              Trigger interactive file selection UI (current directory scope)

DESCRIPTION:
    Reset files to their state in a specific commit without staging changes.
    If a file is specified and N is the target commit, only commits that affect that file are counted.
    This is a destructive operation that overwrites working directory files.
    By default, interactive selection is scoped to the current directory and
    subdirectories. Use --browse-root to browse the entire repository.

EXAMPLES:
    hug w get a1b2c3              Reset ALL files to commit a1b2c3
    hug w get a1b2c3 --           Interactive file selection (current directory)
    hug w get a1b2c3 --browse-root  Interactive file selection (full repository)
    hug w get --upstream          Reset ALL files to the upstream branch state
    hug w get -u file.js          Reset specific file to upstream branch state
    hug w get HEAD~5 file.js      Reset specific file to 5 branch commits ago
    hug w get 5 file.js           Reset specific file to its state 5 commits before its last change
    hug w get main src/app.js     Reset file to main branch state

SAFETY REQUIREMENTS:
    • Affected files must have no staged or unstaged changes
    • Files must exist in the target commit

SEE ALSO:
    hug w discard       Discard unstaged changes

EOF
}

# Reset all files to commit
#
# 3-STATE GATE (mirrors reset_specific_files's contract, adapted to all-files):
#   • State A (clean)            — nothing unrecoverable can be lost, so no
#                                  prompt, no flag. Falls through to the
#                                  "Already at target" early-exit if the tree
#                                  is also at the target (no files differ).
#   • State B (at-risk, not forced) — refuse via check_working_tree_clean, which
#                                  exits 1 with the byte-locked wipe/wipe-all
#                                  remediation text + counts + `hug sl` pointer
#                                  (do NOT printf our own refusal). Crucially
#                                  the gate scopes to the WHOLE tracked worktree,
#                                  not just the changed files — see #220 note below.
#                                  "At-risk" = dirty ∪ untracked-in-target (the
#                                  restore would destroy either kind of content).
#   • State C (at-risk, forced)   — proceed. Notice fires ONLY when at-risk > 0
#                                  (force-on-clean stays silent — no
#                                  "Discarding 0 file(s)" chatter). Wording is
#                                  "(will be overwritten or deleted)": all-files
#                                  BOTH overwrites (git restore --staged
#                                  --worktree .) AND `xargs rm -f`s files absent
#                                  from target — so "or deleted" is the truth
#                                  here, unlike specific-files' "overwritten".
reset_all_files() {
  local commit="$1"
  local force="$2"
  local dry_run="${3:-false}"
  local commit_short

  commit_short=$(git rev-parse --short "$commit")

  if ! $force; then
    printf "Will reset ALL files to commit %s (%s)\n" "$commit" "$commit_short" >&2
  fi

  # Classify files by change type using git diff --diff-filter.
  # --no-renames ensures deterministic classification: each file gets exactly one
  # of M/A/D, never silently omitted as part of a rename pair.
  # Direction: "$commit" HEAD means "what changed FROM target commit TO current HEAD".
  # M = content differs, D = present in target but absent from HEAD, A = absent from target but present in HEAD.
  # Together these three arrays ARE the full target→HEAD diff set (every path
  # that differs between $commit and HEAD). There is deliberately no concatenated
  # "affected_files" variable: the gate below scopes to the WHOLE worktree, not
  # this set — see the #220 note. (A concatenation would also need no dedup, the
  # M/D/A filters being disjoint — but it is simply never needed.)
  local -a files_to_modify files_to_restore files_to_remove

  mapfile -t files_to_modify < <(git diff --name-only --no-renames --diff-filter=M "$commit" HEAD)
  mapfile -t files_to_restore < <(git diff --name-only --no-renames --diff-filter=D "$commit" HEAD)
  mapfile -t files_to_remove < <(git diff --name-only --no-renames --diff-filter=A "$commit" HEAD)

  # Compute the whole-tree at-risk set: dirty (staged/unstaged tracked) PLUS untracked
  # files the reset-all restore (`git restore --staged --worktree .`) would overwrite —
  # i.e. untracked files present in the target commit (git diff can't see them;
  # elifarley/hug-scm#225 P1). comm -12 keeps only paths on BOTH sides; both inputs
  # are sorted (get_untracked_files sorts internally, ls-tree output is piped to sort)
  # which comm REQUIRES — unsorted input yields silently wrong intersections.
  local -a dirty=() untracked_in_target=() at_risk=()
  mapfile -t dirty < <(get_dirty_files)
  mapfile -t untracked_in_target < <(comm -12 <(get_untracked_files) <(git ls-tree -r --name-only "$commit" | sort))
  mapfile -t at_risk < <({
    # Guard each expansion with (( ${#arr[@]} )) && so an EMPTY array never reaches
    # "${arr[@]}": on bash < 4.4 that expansion raises "unbound variable" under set -u
    # INSIDE the process substitution, killing the subshell -> mapfile sees nothing ->
    # at_risk empty -> gate wrongly reports clean -> silent data loss in the exact P1
    # case (the refuse path leaves dirty empty). ${#arr[@]} is a count and never errors
    # under set -u; (( 0 )) short-circuits the && (and is exempt from set -e as a
    # non-final &&-list member), so the printf is simply skipped. Safe pre-4.4.
    ((${#dirty[@]})) && printf '%s\n' "${dirty[@]}"
    ((${#untracked_in_target[@]})) && printf '%s\n' "${untracked_in_target[@]}"
  } | grep -v '^$' | sort -u)

  # STATE B — refuse if at-risk and not forced (before any preview). Override source
  # is HUG_FORCE (not the local $force bool, which is display-chatter only): this is
  # what makes -y (HUG_YES) NOT authorize destroying uncommitted work. When tracked
  # files are dirty we defer to check_working_tree_clean (byte-locked wipe/wipe-all
  # message, exits 1); when ONLY untracked-in-target files are at risk we emit a
  # dedicated refusal. error() exits, so neither path falls through to the restore.
  if [[ ${HUG_FORCE:-} != true ]] && [ ${#at_risk[@]} -gt 0 ]; then
    if [ ${#dirty[@]} -gt 0 ]; then
      check_working_tree_clean # byte-locked wipe/wipe-all message; exits 1
    fi
    # Only untracked-in-target file(s) at risk.
    error_untracked_overwrite "$commit_short" "${untracked_in_target[@]}"
  fi

  # Early-exit: nothing to reset (no files differ AND nothing at risk). Requires
  # at_risk empty too — an untracked-in-target file means the restore is NOT a no-op
  # (it would materialize that path from the target commit), so we must not skip it.
  if [ ${#files_to_modify[@]} -eq 0 ] && [ ${#files_to_restore[@]} -eq 0 ] && [ ${#files_to_remove[@]} -eq 0 ] && [ ${#at_risk[@]} -eq 0 ]; then
    info "Already at target commit $commit_short — no files to reset."
    return 0
  fi

  # STATE C — forced with at-risk files: notice names everything at risk. Says
  # "overwritten or deleted" because the path below BOTH overwrites (git restore
  # --staged --worktree .) AND `xargs rm -f`s files absent from target (contrast
  # reset_specific_files, which never `rm -f`s — "(will be overwritten)" only).
  if [[ ${HUG_FORCE:-} == true ]] && [ ${#at_risk[@]} -gt 0 ]; then
    warning "Discarding uncommitted changes in ${#at_risk[@]} file(s) (will be overwritten or deleted):"
    printf "  %s\n" "${at_risk[@]}" >&2
  fi

  if ! $force || $dry_run; then
    printf "Files that will be MODIFIED:\n" >&2
    if [ ${#files_to_modify[@]} -gt 0 ]; then
      printf "  %s\n" "${files_to_modify[@]}" >&2
    else
      printf "  (no changes from current HEAD)\n" >&2
    fi
    printf "\n" >&2
    if [ ${#files_to_restore[@]} -gt 0 ]; then
      printf "Files that will be RESTORED:\n" >&2
      printf "  %s\n" "${files_to_restore[@]}" >&2
      printf "\n" >&2
    fi
    if [ ${#files_to_remove[@]} -gt 0 ]; then
      printf "Files that will be REMOVED:\n" >&2
      printf "  %s\n" "${files_to_remove[@]}" >&2
      printf "\n" >&2
    fi
    if $dry_run; then
      info "Dry run — no files were modified."
      return 0
    fi
  fi

  # Perform the reset
  if ! $force; then
    printf "Resetting all files to %s...\n" "$commit" >&2
  fi
  if [ ${#files_to_remove[@]} -gt 0 ]; then
    printf "%s\n" "${files_to_remove[@]}" | xargs rm -f
  fi
  git restore --source="$commit" --staged --worktree . 2> /dev/null || {
    # Fallback for older git versions
    git read-tree "$commit"
    git checkout-index -a -f
  }

  success "All files reset to $commit_short"
}

# Reset specific files
#
# 3-STATE GATE (replaces the per-file check_file_staged/check_file_unstaged
# loop AND the bespoke `confirm "Reset these files? (y/N)"` prompt):
#   • State A (clean)        — nothing unrecoverable can be lost, so no prompt,
#                              no flag. Under no-TTY this SUCCEEDS (no `read`),
#                              which is the whole point: a clean restore must
#                              not demand -f (elifarley/hug-scm#218 Concern 1).
#   • State B (at-risk, not forced) — refuse, even under -y. -y auto-confirms
#                              *prompts*; there is no prompt here, only a hard
#                              refusal protecting uncommitted work. We delegate
#                              to check_files_clean so the byte-locked
#                              wipe/wipe-all remediation text stays the single
#                              source of truth (do NOT printf our own refusal).
#                              "At-risk" = dirty ∪ untracked (the restore would
#                              destroy either kind of content).
#   • State C (at-risk, forced)   — proceed. Notice fires ONLY when at-risk > 0
#                              (force-on-clean stays silent; today's force path
#                              is silent and we keep it that way — no
#                              "Discarding 0 file(s)" chatter). Wording is
#                              "(will be overwritten)": specific-files never
#                              `rm -f`s files that are absent from the target,
#                              so "or deleted" would be a lie (that's
#                              reset_all_files's contract).
#
# Override source: HUG_FORCE (exported by parse_common_flags when -f/--force is
# parsed) is the single source of truth for the gate. The local `force` boolean
# is the same fact used for the "skip verbose chatter when forced" display
# branches; the spec calls for reading HUG_FORCE in the gate, so we do.
reset_specific_files() {
  local commit="$1"
  local force="$2"
  local dry_run="${3:-false}"
  shift 3
  local files=("$@")
  local commit_short

  commit_short=$(git rev-parse --short "$commit")

  if ! $force; then
    printf "Will reset files to commit %s (%s):\n" "$commit" "$commit_short" >&2
  fi

  # Validate existence per-file (genuinely per-file — only the cleanliness
  # check was batched into the state gate below).
  local files_to_reset=()
  local file
  for file in ${files[@]+"${files[@]}"}; do
    if ! $force; then
      printf "Checking %s...\n" "$file" >&2
    fi
    check_file_in_commit "$commit" "$file"
    files_to_reset+=("$file")
  done

  if [ ${#files_to_reset[@]} -eq 0 ]; then
    info "No files to reset"
    return 0
  fi

  # ---- STATE GATE. At-risk = files whose uncommitted content the restore would
  # destroy: dirty (staged/unstaged) OR untracked. An untracked target file still
  # holds uncommitted content the restore overwrites (it passed check_file_in_commit,
  # so it exists in the target commit) — git diff cannot see it, so detect it
  # explicitly (elifarley/hug-scm#225 P1).
  local -a dirty_files=() untracked_files=() at_risk=()
  mapfile -t dirty_files < <(get_dirty_files "${files_to_reset[@]}")
  mapfile -t untracked_files < <(get_untracked_files "${files_to_reset[@]}")
  mapfile -t at_risk < <({
    # Guard each expansion (see reset_all_files): an empty "${arr[@]}" under set -u on
    # bash < 4.4 kills the process substitution and silently disables this guard.
    ((${#dirty_files[@]})) && printf '%s\n' "${dirty_files[@]}"
    ((${#untracked_files[@]})) && printf '%s\n' "${untracked_files[@]}"
  } | grep -v '^$' | sort -u)

  if [ ${#at_risk[@]} -eq 0 ]; then
    # STATE A — clean (nothing dirty, no untracked target): nothing to lose.
    if ! $force; then
      info "Files are clean (no uncommitted changes); restoring ${#files_to_reset[@]} file(s) from $commit_short."
    fi
  else
    if [[ ${HUG_FORCE:-} != true ]]; then
      # STATE B — refuse. Uncommitted content would be destroyed.
      if [ ${#dirty_files[@]} -gt 0 ]; then
        check_files_clean "${files_to_reset[@]}" # byte-locked wipe/wipe-all message; exits 1
      fi
      # Only untracked file(s) at risk (no staged/unstaged changes).
      error_untracked_overwrite "$commit_short" "${untracked_files[@]}"
    fi
    # STATE C — forced: proceed, notice names every at-risk file.
    warning "Discarding uncommitted changes in ${#at_risk[@]} file(s) (will be overwritten):"
    printf "  %s\n" "${at_risk[@]}" >&2
  fi

  # Show what will be reset (preview) — only meaningful when we will proceed.
  # ! $force || $dry_run matches the old display branch: forced clean stays
  # silent, but a forced --dry-run still shows the preview.
  if ! $force || $dry_run; then
    printf "\nFiles to be reset:\n" >&2
    printf "  %s\n" "${files_to_reset[@]}" >&2
    printf "\nPreview of changes:\n" >&2
    for file in "${files_to_reset[@]}"; do
      preview_file_changes "$commit" "$file"
    done
    if $dry_run; then
      info "Dry run — no files were modified."
      return 0
    fi
  fi

  if ! $force; then
    printf "Resetting files...\n" >&2
  fi
  # BUG-4 (#292): the explicit `--` ends option parsing so a file literally
  # named like a flag (e.g. `-weird`) is never misread as one.
  git restore --source="$commit" --worktree -- "${files_to_reset[@]}"
  success "Files reset to $commit_short"
}

# Main function
main() {
  test "${1:-}" = '-h' -o "${1:-}" = '--help' && {
    show_help
    exit 0
  }

  check_git_repo

  # Initialize state variables
  local use_upstream=false
  local use_integer_N=false
  local integer_N=0
  local commit=""
  local target_identifier=""

  # 1. Uniform pathspec split (#292 PR-C, w-get migration — plan Task 9):
  # flags before '--', pathspecs after it, ONE validated ${pathspecs[@]}
  # feeding every downstream sink (specific-files restore, the N-back
  # per-file counting, the picker's empty-set trigger).
  #
  # WITH --picker on purpose: a trailing bare '--' is w-get's documented
  # interactive-selection trigger (OQ-1 probed: `w get HEAD --` → picker →
  # non-TTY "No files selected..." exit 0). The --picker mode preserves
  # that trigger exactly; the bare '--' never becomes a phantom pathspec,
  # so the reset-all arm keeps its empty-scope semantics.
  #
  # NOTE: "--target" is NOT a flag of this command — it is only the error
  # CONTEXT LABEL inside validate_commitish (hug-git-repo). The probed
  # "Invalid commitish for --target: --dry-run" receipt was the TARGET
  # SLOT swallowing a flag, which the contract below kills.
  eval "$(parse_common_flags_with_pathspecs --picker "$@")"

  # Initialize common flag variables if not set by parse_common_flags
  : "${browse_root:=false}"
  : "${force:=false}"
  : "${dry_run:=false}"

  # 2. w-get is the family's ONE command with a commitish TARGET positional,
  # which parse_scoped_own_flags's all-positionals-are-pathspecs grammar
  # cannot express — so a small hand-rolled PRE-PASS runs first (this is
  # the documented, deliberate partial adoption of the helper):
  #   • extract the order-independent -u/--upstream wherever it appears
  #     among the pre-args (pinned: 'w get -f -u src/a.py'); under -u every
  #     positional is a FILE (#292 spec §5.2, BUG-3), so the target slot
  #     must not be decided until -u detection is complete;
  #   • split the remaining pre-args into the optional target (first
  #     positional, only when NOT under -u) and the file positionals;
  #   • stray dash tokens are NOT handled here — they pass through to the
  #     family helper below, whose loud -* arm rejects them with the
  #     uniform template. (Was: the target slot swallowed them —
  #     "Invalid commitish for --target: -xX", exit 1.)
  local -a own_dash=() positionals=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
    -u | --upstream)
      use_upstream=true
      ;;
    -*)
      own_dash+=("$1")
      ;;
    *)
      positionals+=("$1")
      ;;
    esac
    shift
  done
  local -a file_args=()
  if ! $use_upstream && [ ${#positionals[@]} -gt 0 ]; then
    target_identifier="${positionals[0]}"
    file_args=("${positionals[@]:1}")
  else
    file_args=("${positionals[@]}")
  fi

  # 3. Family helper (#292 PR-C Task 5), partial adoption as documented
  # above: completes the ONE pathspecs array from the split (post-'--'
  # data) ∪ the file positionals, rejects unknown pre-'--' dash tokens
  # loudly (arm 2), and rejects post-'--' EXACT spellings of this
  # command's flags (arm 3; own spec -u/--upstream included —
  # 'w get HEAD~1 -- -u' is a misordered flag, not a file; './-u' is the
  # documented escape hatch for a file literally named '-u').
  local -a pathspecs=()
  parse_scoped_own_flags "hug w get" "-u:--upstream:use_upstream" \
    pathspecs ${own_dash[@]+"${own_dash[@]}"} ${file_args[@]+"${file_args[@]}"}

  # Loud one-time pathspec validation before any arm runs (see
  # validate_pathspecs_or_die in hug-git-files for the WHY): a typo'd
  # magic prefix must die as a usage error, never as a confusing
  # "File ':bogus(' does not exist" downstream.
  validate_pathspecs_or_die ${pathspecs[@]+"${pathspecs[@]}"}

  # 4. Shape guard under --upstream (review fix, #292 PR-A): every remaining
  # argument is supposed to be a FILE, but a 1-2 digit integer or a token
  # that resolves as a commitish is far more likely a mistyped
  # `hug w get <N|commit>` than a file name — and reclassifying user
  # mistakes as file names is only loud when the file happens not to exist
  # (otherwise the confusing "File 'HEAD~5' does not exist"). Fail with the
  # OLD explicit message BEFORE anything prints. Trade-off (deliberate): a
  # file literally named e.g. '2' is unreachable under -u.
  if $use_upstream && [ ${#file_args[@]} -gt 0 ]; then
    for arg in "${file_args[@]}"; do
      if [[ "$arg" =~ ^[0-9]{1,2}$ ]] || git rev-parse --verify -q "$arg" > /dev/null 2>&1; then
        error "Cannot specify --upstream with a specific commit or integer N."
      fi
    done
  fi

  # 5. Classify the target — UNLESS -u/--upstream was given: with --upstream
  # there is NO target positional (its subjects cannot exist, which is why
  # the old "-u + commit / -u + integer N" exclusivity guard stays gone BY
  # CONSTRUCTION; a nonexistent file under -u still fails loudly via
  # check_file_in_commit).
  if ! $use_upstream; then
    if [[ -z "$target_identifier" ]]; then
      error "Missing target argument.
       Usage: hug w get <commit> [file...]
       Use 'hug w get --help' for more information"
      exit 1
    fi
    if [[ "$target_identifier" =~ ^([0-9]|[1-9][0-9]?)$ ]]; then
      use_integer_N=true
      integer_N="$target_identifier"
    else
      commit="$target_identifier"
    fi
  fi

  # 6. Determine the target commit
  if $use_upstream; then
    commit=$(get_upstream_commit)
  elif $use_integer_N; then
    # Pass the collected file scope to the helper (N counts commits that
    # touch the files in scope)
    commit=$(get_commit_n_back "$integer_N" ${pathspecs[@]+"${pathspecs[@]}"})
  elif [[ -z "$commit" ]]; then
    # This case should not be reached due to earlier checks, but as a fallback
    error "Internal error: Could not determine target commit."
    exit 1
  fi

  # 7. Validate commit
  validate_commitish "--target" "$commit"

  # 8. Check if user wants interactive file selection via --
  if [[ "${HUG_INTERACTIVE_FILE_SELECTION:-}" = "true" ]]; then
    # Interactive file selection
    declare -a select_opts=("--multi" "--staged" "--unstaged" "--untracked")

    # Default to --cwd (current directory scope) unless --browse-root is specified
    if ! $browse_root; then
      select_opts+=("--cwd")
    fi

    select_opts+=("--prompt" "Select files to reset...")

    selected_files=()
    if ! mapfile -t selected_files < <(select_files_with_status "${select_opts[@]}"); then
      info "No files selected or cancelled."
      exit 0
    fi

    if [ ${#selected_files[@]} -eq 0 ]; then
      info "No files selected."
      exit 0
    fi

    # Reset selected files
    reset_specific_files "$commit" "$force" "$dry_run" "${selected_files[@]}"
    exit 0
  fi

  # 9. Determine operation mode and execute — the ONE ${pathspecs[@]} is
  # the file scope everywhere: empty → reset-all, else specific-files.
  # (No trailing status summary exists to suppress on the scoped path —
  # probed: both arms end at their success/info line, w-get never prints
  # the `hug s`-style summary line, same disposition Task 3 documented for
  # w-discard.)
  if [ ${#pathspecs[@]} -eq 0 ]; then
    # Reset ALL files
    reset_all_files "$commit" "$force" "$dry_run"
  else
    # Reset specific files
    reset_specific_files "$commit" "$force" "$dry_run" ${pathspecs[@]+"${pathspecs[@]}"}
  fi
}

# Run main function with all arguments
main "$@"
