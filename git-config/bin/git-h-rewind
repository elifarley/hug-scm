#!/usr/bin/env bash
_hug_category='["head"]'
_hug_keywords='["rewind", "destructive-back", "force-back"]'
test "${1:-}" = '--search-meta' && {
  printf 'category = %s\nkeywords = %s\n' "$_hug_category" "$_hug_keywords"
  exit 0
}
CMD_BASE="$(readlink -f "$0" 2> /dev/null || greadlink -f "$0")" || CMD_BASE="$0"
CMD_BASE="$(dirname "$CMD_BASE")"
for f in hug-common hug-git-kit; do . "$CMD_BASE/../lib/$f"; done
set -euo pipefail # Exit on error, undefined vars, pipe failures
# Part of the Hug tool suite

show_help() {
  cat << EOF
hug h rewind: Make HEAD walk back some commits while DISCARDING their changes. Uncommitted changes are DISCARDED.

USAGE:
    hug h rewind [N|COMMIT] [-u, --upstream] [-t, --temporal TIME] [--quiet] [--force]

OPTIONS:
    -u, --upstream  Sets target to upstream remote tip after read-only preview/confirmation (discards everything after remote tip; no fetch)
    -t, --temporal TIME
                    Specify commits by time instead of count/commit
                    TIME can be relative (e.g., "3 days ago", "1 week ago")
                    or absolute (e.g., "2024-01-15", "2024-01-15 10:30")
                    Reference point is HEAD's commit time
    --quiet         Suppress output (sets HUG_QUIET=T)
    --force         Skip confirmation prompts (use with caution; highly destructive)
    -y, --yes       Without tracked edits: proceeds (warn — fully recoverable).
                    With tracked edits: refused (danger — edits unrecoverable); use --force.

DESCRIPTION:
    Moves HEAD back to target (full clean). With -u, runs a read-only preview/confirmation before discarding local-only commits and uncommitted changes to sync with remote tip.
    With -t/--temporal, moves HEAD to the first commit at or after the specified time.

EXAMPLES:
    # Uncommitted changes are DISCARDED in all examples below:
    hug h rewind -u              # Moves HEAD back to upstream
    hug h rewind 3               # Moves HEAD back last 3 commits
    hug h rewind a1b2c3          # Moves HEAD back after specified commit
    hug h rewind 3 --force       # Skip confirmation (dangerous!)
    hug h rewind -t "3 days ago" # Rewind to first commit from 3 days ago
    hug h rewind -t "1 week ago" # Rewind to first commit from 1 week ago

SEE ALSO:
    hug h back    Make HEAD walk back some commits while keeping their changes staged

RESTORE
    h-rewind is inverted by:
        hug h restore <pre-op-HEAD> --rewind -y
    On a successful h-rewind of a CLEAN tree, hug prints this exact line with the
    pre-op SHA filled in. (--rewind ≡ git reset --hard back to the old HEAD.)
    Immediately after h-rewind the tree is tracked-clean, so the printed -y hint
    proceeds; restore --rewind -f is needed only if you dirty the tree before
    recovering.

NOTES:
    Clean tree: HEAD moves only — fully recoverable via restore --rewind.
    Dirty tree: uncommitted tracked edits are DESTROYED and cannot be recovered.
    Untracked and ignored files are never affected.
EOF
}

# Parse common flags (--quiet, --force, -h|--help)
eval "$(parse_common_flags "$@")"

# Parse temporal flag
eval "$(parse_temporal_flag "$@")"

# Parse remaining custom flags
upstream=false
target_arg=""
while [[ $# -gt 0 ]]; do
  case "$1" in
  -u | --upstream)
    upstream=true
    shift
    ;;
  *)
    target_arg="$1"
    shift
    ;;
  esac
done

check_git_repo

# tier computed from tracked-dirty state. Clean tree → warn (HEAD moves only;
# fully recoverable via restore --rewind). Dirty tree → danger (tracked edits
# would be destroyed by --hard → unrecoverable data loss).
tier=warn # default: no tracked changes → safe, full recovery exists
if has_uncommitted_tracked_changes; then
  tier=danger
fi

if $upstream; then
  # Use DRY helper for validation, then handle upstream-specific logic.
  target=$(resolve_target_with_temporal "$upstream" "$temporal_spec" "$target_arg" 'HEAD~1') || exit 1

  # handle_upstream_operation performs validation, preview, and tier-based
  # confirmation (danger→prompt_confirm_danger, warn→prompt_confirm_warn).
  # Passing $tier directly retires the HUG_FORCE=true inline-prefix hack: the
  # helper now gates at the operation's real tier instead of being bypassed.
  target=$(handle_upstream_operation "rewinding" "$tier" "rewind" "git reset --hard to upstream is irreversible") || exit $?
  if [[ -z "${target:-}" ]]; then
    exit 0
  fi
else
  # Use DRY helper for validation and target resolution
  target=$(resolve_target_with_temporal "$upstream" "$temporal_spec" "$target_arg" 'HEAD~1') || exit 1

  # Handle command-specific preview and confirmation
  handle_standard_operation "rewinding" "$target" false

  case "$tier" in
  danger)
    printf '\n⚠️  This is PERMANENT and cannot be undone!\n' >&2
    prompt_confirm_danger "rewind" "git reset --hard is irreversible and cannot be undone"
    ;;
  warn)
    prompt_confirm_warn "Rewind HEAD to $(git rev-parse --short "$target")? [y/N]: "
    ;;
  esac
fi

pre_op_head=$(git rev-parse HEAD)
printf 'Rewinding to %s...\n' "$target" >&2
git reset --hard "$target"
printf 'Rewind complete. Repository is now at %s\n' "$(git rev-parse --short "$target")" >&2

# Post-op messaging varies by tier per §9:
#   dirty (danger) — edits are unrecoverable; print the commit-recovery hint
#   clean (warn)   — full recovery exists; print restore --rewind -y
case "$tier" in
danger)
  warning "Uncommitted edits were destroyed and cannot be recovered."
  emit_head_recovery_hint "$pre_op_head" "rewind"
  ;;
warn)
  emit_head_recovery_hint "$pre_op_head" "rewind"
  ;;
esac
