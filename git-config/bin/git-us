#!/usr/bin/env bash
_hug_category='["staging"]'
_hug_keywords='["unstage", "reset-staged", "untrack-staged"]'
test "${1:-}" = '--search-meta' && {
  printf 'category = %s\nkeywords = %s\n' "$_hug_category" "$_hug_keywords"
  exit 0
}
# Assume HUG_HOME is set (exported by hug or environment)
# shellcheck source=git-config/lib/hug-common
. "$HUG_HOME/git-config/lib/hug-common"
# shellcheck source=git-config/lib/hug-git-kit
. "$HUG_HOME/git-config/lib/hug-git-kit"
# shellcheck source=git-config/lib/hug-file-input
. "$HUG_HOME/git-config/lib/hug-file-input"
set -euo pipefail # Exit on error, undefined vars, pipe failures
# Part of the Hug tool suite

show_help() {
  # Quoted delimiter: the pathspec contract text mentions `--` in backticks,
  # and an UNQUOTED heredoc would run them as command substitutions
  # ("--: command not found" before every -h). Nothing here needs expansion.
  cat << 'EOF'
hug us: UnStage one or more files

USAGE:
    hug us [OPTIONS] [<pathspec>...]

ARGUMENTS:
    <pathspec>...      One or more file paths / pathspecs to unstage
                       If not provided, shows interactive list for selection

OPTIONS:
    --from-file <file>    Read file list from file or stdin (use '-' for stdin)
    --from-commit <commit> Use files changed in the specified commit
                           (INTERSECTED with any pathspecs given — the
                           pathspecs are a scope, so only in-scope source
                           files are unstaged)
    -- <path>...          Pathspecs scope the unstaging (git magic pathspecs
                          like ':(exclude)src/' work); positionals also
                          work — `--` is only needed for paths starting
                          with '-'. A trailing bare `--` alone is inert
                          (same as no arguments: opens the selector).
    --dry-run          Preview the unstage operation without applying changes
    -f, --force        Skip confirmation prompts (sets HUG_FORCE=true)
    --quiet            Suppress output (sets HUG_QUIET=T)
    -h, --help         Show this help

DESCRIPTION:
    Unstages one or more files (removes them from the staging area while keeping
    the changes in the working directory). This is equivalent to 'git restore --staged'.

    When no file names are provided, displays an interactive menu using gum filter
    (if installed) for multi-selection. This makes it easy to select multiple
    files to unstage at once.

    If no staged files exist, displays an informative message.

    The --from-file flag reads file names from a file or stdin. It intelligently
    parses both simple file lists (one per line) and the output from 'hug sh'.

    The --from-commit flag directly extracts files from a commit's changes,
    providing an optimized workflow for unstaging the same files as a previous commit.

PATH FILTERING:
    Append -- <path>... to restrict output to matching paths.
    Globs must be quoted; see 'hug help :pathspec' for the full contract.

    hug us -- src/                    # unstage only files under src/
    hug us -- ':(exclude)docs/'      # unstage everything EXCEPT docs/

EXAMPLES:
    hug us                               # Interactive: select files to unstage
    hug us file.txt                      # Unstage single file
    hug us src/main.js tests/test.js     # Unstage multiple files
    hug us --from-file files.txt         # Unstage files from list
    hug us --from-commit HEAD~1          # Unstage files from previous commit
    hug sh HEAD~2 | hug us --from-file - # Unstage files from hug sh output
    hug us --dry-run                     # Preview which files would be unstaged

SEE ALSO:
    hug a          Stage tracked files
    hug aa         Stage all files (including untracked)
    hug usa        Unstage all files
EOF
}

# Uniform pathspec split (#292 PR-B Task 8): flags before '--', pathspecs
# after it — see parse_common_flags_with_pathspecs in hug-cli-flags for the
# contract. WITHOUT --picker on purpose: us's interactive selector is the
# ZERO-ARGS fallback (the gum staged-file filter in hug_us below), not the
# picker arm, so a trailing bare '--' is consumed inertly and
# `hug us --` ≡ `hug us` (same dispatch, same output).
from_file=""
from_commit=""
pathspecs=()

eval "$(parse_common_flags_with_pathspecs "$@")"

# NOTE: parse_common_flags (inside the split) CONSUMED -q/--quiet and
# exported HUG_QUIET — us has no local quiet variable to rehydrate (the
# info/success helpers read HUG_QUIET directly), hence no -q arm below.
# -h/--help need no arm either: the split routes them to show_help + exit 0.

# Seed the ONE pathspec collection with the split's post-'--' data first;
# pre-arg positionals join it in the own-loop below (git unions pathspecs;
# ONE array so every sink — the plain unstage list AND the from-source
# filter — reads the same scope).
pathspec_pathspecs_into pathspecs

# Own-loop over the pre-args only (common flags already consumed by the
# split): us's accepted pre-'--' grammar. Value-taking flags carry the
# post-#300 value guard (git-a style): '--from-file' alone at argv end
# must die loudly as a usage error, not silently unstage nothing.
# Unknown tokens are ONLY the -* class — bare positionals collect as
# pathspecs (git parity: 'hug us src/a.py' works today and keeps working;
# same rule as the sl* family post-Task-5).
while [[ $# -gt 0 ]]; do
  case "$1" in
  --from-file)
    [[ $# -ge 2 ]] || error "--from-file requires a value." "$HUG_EX_USAGE"
    from_file="$2"
    shift 2
    ;;
  --from-commit)
    [[ $# -ge 2 ]] || error "--from-commit requires a value." "$HUG_EX_USAGE"
    from_commit="$2"
    shift 2
    ;;
  -*)
    # Loud by contract (was: exit 1 with a bare message). exit 2 =
    # HUG_EX_USAGE; family template — see sl_family_main's unknown-option
    # arm in hug-status-listing.
    error_usage "Unknown option: $1. Pathspecs beginning with '-' require '--': hug us -- $1. See 'hug help :pathspec'."
    ;;
  *)
    pathspecs+=("$1")
    shift
    ;;
  esac
done

# Repo check comes BEFORE the from-source branch now: the intersection
# filter below runs `git ls-files`, and extract_files_from_commit already
# ran git before this point anyway (parsing/-h still precede it, so
# `hug us -h` keeps working from any cwd).
check_git_repo

# Loud one-time pathspec validation (#298 roast MAJOR 1): a malformed magic
# pathspec used to reach the suppressed git captures below, which answered
# the EMPTY result ("No files matching … to unstage.", exit 0) while git's
# fatal vanished — a typo looked like a no-match. Must run at this command
# entry: both downstream sinks suppress or subshell the failure away. See
# validate_pathspecs_or_die (hug-git-files) for the contract.
validate_pathspecs_or_die ${pathspecs[@]+"${pathspecs[@]}"}

# Handle file input flags
if [[ -n "$from_file" || -n "$from_commit" ]]; then
  files_from_source=()

  if [[ -n "$from_commit" ]]; then
    # Command substitution, NOT '< <(…)' (codex P2 — same exit-swap class
    # as the from_file conversion below): extract_files_from_commit errors
    # loudly itself ("Commit 'X' does not exist"), but the process
    # substitution swallowed that exit — the error PRINTED and both
    # downstream arms then answered a friendly no-match ("Source list is
    # empty …" with a scope, "No staged files to unstage." without) with
    # exit 0: automation read a failed unstage as success. '$(…) || exit $?'
    # keeps the failure fatal, exactly like read_files_from_source.
    from_source_out=""
    from_source_out=$(extract_files_from_commit "$from_commit") || exit $?
    if [[ -n "$from_source_out" ]]; then
      mapfile -t files_from_source <<< "$from_source_out"
    fi
  elif [[ -n "$from_file" ]]; then
    # Command substitution, NOT '< <(…)' (code-roast MINOR): the process
    # substitution swallowed read_files_from_source's exit — its error()
    # exited only the SUBSHELL, mapfile saw an empty list, and the flow
    # fell through to the zero-args selector with a printed-but-ignored
    # error. '$(…) || exit $?' keeps the failure fatal; mapfile splits
    # the captured multi-line string exactly like the old stream.
    from_source_out=""
    from_source_out=$(read_files_from_source "$from_file") || exit $?
    if [[ -n "$from_source_out" ]]; then
      mapfile -t files_from_source <<< "$from_source_out"
    fi
  fi

  # INTERSECTION, never concat (contract §3.1): the pathspecs are a SCOPE —
  # a union (`files_from_source += pathspecs`) would unstage source files
  # OUTSIDE it, the opposite of what the user asked. Filter the source list
  # through git's own pathspec engine (`git ls-files --full-name --` = the
  # tracked set in scope) so git magic pathspecs behave here exactly as in
  # the listings. An EMPTY scope (no pathspecs given) keeps today's
  # behavior: the full source list, unfiltered.
  if [[ ${#pathspecs[@]} -gt 0 ]]; then
    scope_files=()
    build_scope_set scope_files ${pathspecs[@]+"${pathspecs[@]}"}
    # O(n+m) membership filter (assoc array), not O(n·m) — unchanged glue.
    declare -A in_scope=()
    for s in ${scope_files[@]+"${scope_files[@]}"}; do in_scope["$s"]=1; done

    # Record whether the SOURCE list is empty BEFORE the intersection
    # (code-roast F-004): an empty result downstream is then attributable —
    # an empty source never excluded anything, so blaming the pathspec
    # ("No files matching 'src/'") misattributes the cause.
    source_list_empty=false
    [[ ${#files_from_source[@]} -eq 0 ]] && source_list_empty=true
    canonical_source=()
    unresolved_source=()
    if [[ -n "$from_commit" ]]; then
      canonicalize_source_lines canonical_source unresolved_source --from-commit \
        ${files_from_source[@]+"${files_from_source[@]}"}
    else
      canonicalize_source_lines canonical_source unresolved_source \
        ${files_from_source[@]+"${files_from_source[@]}"}
    fi
    filtered_source=()
    # INTERSECTION, never concat (PR #318 review, codex P1 — restores
    # git-us's original contract §3.1): the pathspecs are a SCOPE. A source
    # list ['a.txt','b.txt'] against scope 'a.txt' must forward ONLY a.txt;
    # copying all canonical entries would unstage b.txt OUTSIDE the scope.
    for f in ${canonical_source[@]+"${canonical_source[@]}"}; do
      if [[ -n "${in_scope[$f]:-}" ]]; then
        filtered_source+=("$f")
      fi
    done
    # ...and BACK to CWD-relative for downstream consumers (validation +
    # git restore resolve against the CWD). Real relpath, not prefix-strip:
    # see root_to_cwd_relpath. The prefix is HOISTED once for the whole
    # list (PR #318 review, red-team: per-file rev-parse was measured at
    # one git subprocess per file). Unresolved spellings are ALREADY
    # CWD-relative (the user's own) — appended untouched.
    cwd_prefix=$(git rev-parse --show-prefix)
    cwd_source=()
    for f in ${filtered_source[@]+"${filtered_source[@]}"}; do
      cwd_source+=("$(root_to_cwd_relpath "$f" "$cwd_prefix")")
    done
    files_from_source=(${cwd_source[@]+"${cwd_source[@]}"} ${unresolved_source[@]+"${unresolved_source[@]}"})

    # Scoped-but-empty is a NO-MATCH, never a selector fall-through
    # (spec-review finding 2): the zero-args selector offers the FULL
    # staged list, which would silently ignore — and with TTY+gum actively
    # unstage OUTSIDE — the scope the user asked for. Same INTENT as
    # git-shc's no-match hint (its shape differs: shc is a stderr printf
    # over raw pathspecs; us uses the info helper with quoted pathspecs).
    # NOTE: unresolved lines are NOT empty-intersection material — when
    # present they skip this arm and die in validation (loud), above.
    if [[ ${#files_from_source[@]} -eq 0 ]]; then
      if $source_list_empty; then
        info "Source list is empty - nothing to unstage."
      else
        pathspec_list=""
        printf -v pathspec_list "'%s' " "${pathspecs[@]}"
        info "No files matching ${pathspec_list% } to unstage."
      fi
      exit 0
    fi
  fi

  files_to_unstage=(${files_from_source[@]+"${files_from_source[@]}"})
else
  files_to_unstage=(${pathspecs[@]+"${pathspecs[@]}"})

  # ONE scoped-empty contract (#298 roast MAJOR 2): a pathspec-shaped scope
  # matching nothing staged used to hit hug_us's per-file safety check and
  # answer "❌ File 'nonexistent/' is not tracked by git." exit 1 — while the
  # from-source branch answered the SAME condition with "No files matching …
  # to unstage." exit 0. Two answers for one condition. Rule: when the scope
  # is pathspec-shaped (directory / glob / magic spelling — anything that is
  # not an existing file on disk) and nothing staged matches it, route to the
  # SAME info + exit-0 arm. LITERAL file arguments (test -f) keep the loud
  # per-file error inside hug_us — that is the safety check preventing a
  # confusing silent no-op when the user names a real file.
  # Deliberately NOT applied to the from-source arm: its list lines are
  # user-supplied FILENAMES (often root-relative spellings that do not exist
  # under the CWD), and an unresolvable line must keep dying LOUD in hug_us's
  # validation (pinned: "File 'src/a.py' is not tracked by git.").
  if [[ ${#files_to_unstage[@]} -gt 0 ]]; then
    # Command substitution, NOT '< <(…)' (code-roast F-002): same shape the
    # #298 MAJOR-1 fix converted three blocks above — the process substitution
    # swallows git's nonzero exit, and a repo-level failure would read as the
    # "No files matching …" no-match below. Empty output must NOT reach mapfile
    # via <<< (a phantom empty element follows); guard with -n.
    # No 'local' here: script scope.
    staged_scope_matches_out=""
    staged_scope_matches_out=$(git diff --cached --name-only -- ${files_to_unstage[@]+"${files_to_unstage[@]}"}) ||
      error "git failed listing staged files for the unstage scope."
    staged_scope_matches=()
    [[ -n "$staged_scope_matches_out" ]] && mapfile -t staged_scope_matches <<< "$staged_scope_matches_out"
    if [[ ${#staged_scope_matches[@]} -eq 0 ]]; then
      has_literal_file=false
      for scope_arg in ${files_to_unstage[@]+"${files_to_unstage[@]}"}; do
        if [[ -f "$scope_arg" ]]; then
          has_literal_file=true
          break
        fi
      done
      if ! $has_literal_file; then
        pathspec_list=""
        printf -v pathspec_list "'%s' " "${files_to_unstage[@]}"
        info "No files matching ${pathspec_list% } to unstage."
        exit 0
      fi
    fi
  fi
fi

# is_scope_shaped (#302 finding 1): classifies whether an argument is a
# directory/glob/magic scope — the f2771623 noun rule. One classifier shared by
# the error-path noun (below) and the success/dry-run scope clause, so the two
# sites classify identically by construction. Stays git-us-local (rule of three
# — no second command needs it yet).
# Short-form magic (#310 codex #3834674455): git also accepts ':!path' / ':^path'
# exclusion and ':/text' top-of-tree spellings — a leading ':' followed by a
# non-digit char (':0'-' :9' are stage numbers, not magic). Without these arms
# the clause went missing for 'us --dry-run -- :!docs/note.md' while git still
# scoped by it (probed).
is_scope_shaped() {
  local arg="$1"
  [[ "$arg" == */ || "$arg" == *'('* || "$arg" == *'*'* || "$arg" == *'?'* || "$arg" == *'['* ||
    "$arg" == ':'[!0-9]* ]]
}

# --- Main function for 'hug us' ---
hug_us() {
  local -a files_to_unstage=("$@")

  # If no files specified, show interactive menu
  if [[ ${#files_to_unstage[@]} -eq 0 ]]; then
    local -a staged_files=()

    # Get all staged files
    mapfile -t staged_files < <(
      git diff --cached --name-only 2> /dev/null || true
    )

    if [[ ${#staged_files[@]} -eq 0 ]]; then
      info "No staged files to unstage."
      exit 0
    fi

    # Check if gum is available
    if ! gum_available; then
      error "Interactive mode requires 'gum' to be installed. Please install it or specify file names directly.
       Install: https://github.com/charmbracelet/gum"
    fi

    # Prepare formatted options for gum with file details
    local -a formatted_options=()

    for file in "${staged_files[@]}"; do
      # Skip empty file names (defensive)
      [[ -z "$file" ]] && continue

      # Get file status (new, modified, etc.)
      local status
      status=$(git diff --cached --name-status "$file" 2> /dev/null | cut -f1 || echo "M")

      local status_text
      case "$status" in
      A) status_text="${GREEN}new${NC}" ;;
      M) status_text="${YELLOW}modified${NC}" ;;
      D) status_text="${RED}deleted${NC}" ;;
      R*) status_text="${BLUE}renamed${NC}" ;;
      C*) status_text="${BLUE}copied${NC}" ;;
      *) status_text="${GREY}changed${NC}" ;;
      esac

      # Format for gum: plain text with details
      local formatted="${file} ${status_text}"
      # Only add non-empty formatted options
      [[ -n "$formatted" ]] && formatted_options+=("$formatted")
    done

    # Additional safety check: ensure we have formatted options
    if [[ ${#formatted_options[@]} -eq 0 ]]; then
      error "No valid staged files found to display. This may be a bug - please report it."
    fi

    # Use gum_filter_by_index for selection with exact matching
    local -a selected_indices=()
    mapfile -t selected_indices < <(
      gum_filter_by_index formatted_options \
        "Select files to unstage (<TAB> to select, Enter to confirm)..." \
        --no-limit
    )

    if [ ${#selected_indices[@]} -eq 0 ]; then
      info "No files selected."
      exit 0
    fi

    # Extract selected files using indices
    files_to_unstage=()
    for idx in "${selected_indices[@]}"; do
      files_to_unstage+=("${staged_files[$idx]}")
    done
  fi

  # Tracked-check options: --with-tree=HEAD (probed) accepts STAGED
  # DELETIONS as tracked — the index entry is gone but the file lives in
  # HEAD — without accepting truly untracked paths. Without it, unstaging
  # a deletion (by name OR via the from-source intersection) is impossible
  # ("not tracked" false negative, Codex P1). Guarded: an unborn HEAD
  # makes --with-tree fatal, and an unborn repo has staged entries but no
  # tree to consult.
  local -a tracked_check=(--error-unmatch)
  git rev-parse --verify -q HEAD > /dev/null 2>&1 && tracked_check+=(--with-tree=HEAD)

  # Validate that files exist and are staged
  for file in "${files_to_unstage[@]}"; do
    # Noun accuracy (#298 roast MAJOR 2): this loop is normally reached only
    # with literal file arguments (the command-level gate above routes
    # scope-shaped no-matches to the info arm), but a MIXED list
    # ('hug us real.txt some/dir/') still lands here when nothing staged
    # matches. Call a directory/glob/magic spelling a "Path", not a "File" —
    # "File 'src/' is not staged" was the probed misleading message.
    local noun="File"
    is_scope_shaped "$file" && noun="Path"

    # The '--' is load-bearing (spec-review finding 1): a staged file
    # literally named '-foo.txt' would otherwise be parsed as an OPTION by
    # git → false "not tracked" error, breaking the 'hug us -- <path>'
    # promise the help text makes.
    if ! git ls-files "${tracked_check[@]}" -- "$file" > /dev/null 2>&1; then
      error "$noun '$file' is not tracked by git."
    fi

    # Check if file is actually staged
    if git diff --cached --quiet -- "$file" 2> /dev/null; then
      error "$noun '$file' is not staged."
    fi
  done

  # Set dry_run default if not already set by parse_common_flags
  local dry_run="${dry_run:-false}"

  # Report targets = the RESOLVED staged files (git's own answer for what
  # these pathspecs unstage: the staged set matching them), NOT the raw
  # pathspecs. A magic spec used to be echoed verbatim — "Unstaged 1 file:
  # ✓ :(exclude)docs/" (code-roast MINOR): wrong count-noun and a useless
  # line. Plain names resolve to themselves, so this is display-only;
  # files_to_unstage still drives validation and 'git restore' above.
  # Command substitution, NOT '< <(…)' (code-roast F-002): the exit-swap
  # shape the #298 MAJOR-1 fix eliminated elsewhere in this file. A failure
  # here would silently fall back to echoing the raw pathspecs below —
  # restoring the "Unstaged 1 file: ✓ :(exclude)docs/" bug one git error away.
  local report_targets_out=""
  report_targets_out=$(git diff --cached --name-only -- ${files_to_unstage[@]+"${files_to_unstage[@]}"}) ||
    error "git failed listing staged files for the unstage report."
  local -a report_targets=()
  [[ -n "$report_targets_out" ]] && mapfile -t report_targets <<< "$report_targets_out"
  if [[ ${#report_targets[@]} -eq 0 ]]; then
    report_targets=(${files_to_unstage[@]+"${files_to_unstage[@]}"})
  fi

  # Scope clause (#302 finding 1): name the FULL scope set when any pathspec is
  # scope-shaped. Git unions pathspecs, so "matching 'X' 'Y'" = matching any of
  # the set = exactly what the count counts. Literal-only invocations get no
  # clause (the ✓ lines already say everything). Reads the converged `pathspecs`
  # array (script scope), NEVER files_to_unstage (the from-source arm holds
  # filtered source FILENAMES, not the user's scope). Built once; consumed by
  # both success and dry-run so they cannot diverge.
  local has_scope=false spec
  for spec in ${pathspecs[@]+"${pathspecs[@]}"}; do
    is_scope_shaped "$spec" && {
      has_scope=true
      break
    }
  done
  local scope_clause=""
  if $has_scope; then
    local scope_list=""
    printf -v scope_list "'%s' " ${pathspecs[@]+"${pathspecs[@]}"}
    scope_clause=" matching ${scope_list% }"
  fi

  # Preview mode
  if [[ "${dry_run}" == "true" ]]; then
    info "Dry run: Would unstage ${#report_targets[@]} file(s)${scope_clause}:"
    for file in "${report_targets[@]}"; do
      printf "  - %s\n" "$file" >&2
    done
    print_dry_run_preview "unstage the listed files"
    return 0
  fi

  # Perform unstaging
  if ! git restore --staged -- "${files_to_unstage[@]}" 2> /dev/null; then
    error "Failed to unstage files. Check file paths and permissions."
  fi

  # Report results
  local count=${#report_targets[@]}
  local file_word="file"
  [[ $count -gt 1 ]] && file_word="files"

  success "Unstaged $count $file_word${scope_clause}:"
  for file in "${report_targets[@]}"; do
    printf "  ✓ %s\n" "$file" >&2
  done
}

hug_us ${files_to_unstage[@]+"${files_to_unstage[@]}"}
