#!/usr/bin/env bash
_hug_category='["status"]'
test "${1:-}" = '--search-meta' && {
  printf 'category = %s\n' "$_hug_category"
  exit 0
}
CMD_BASE="$(readlink -f "$0" 2> /dev/null || greadlink -f "$0")" || CMD_BASE="$0"
CMD_BASE="$(dirname "$CMD_BASE")"
for f in hug-common hug-git-kit hug-select-files output_json_status; do . "$CMD_BASE/../lib/$f"; done # Load common constants and functions
set -euo pipefail                                                                                     # Exit on error, undefined vars, pipe failures

# Part of the Hug tool suite

# Enhanced status: shows detailed file list with color-coded status, then summary

show_help() {
  cat << 'EOF'
hug statusbase: Enhanced status — detailed file list, then a summary line.
Reached as `hug sl` (without untracked files) and `hug sla` (with untracked
files) via gitconfig aliases; running `hug statusbase` directly behaves
like `hug sl`.

USAGE:
  hug statusbase [OPTIONS] [pathspec...]

OPTIONS:
  --long                     Include untracked files (the `sla` alias's flag)
  -u, --untracked-files=all  Same as --long (git-status spelling)
  -uno, --untracked-files=no Exclude untracked files (the `sl` alias's flag)
  -c, --count                Print only the number of matching files (mutually
                             exclusive with --json; count mode also suppresses
                             the trailing summary)
  --json                     Output the unified JSON envelope
  -q, --quiet                Suppress informational output and the trailing
                             summary line
  -- <path>...               Pathspecs scope the listing (git magic pathspecs
                             like ':(exclude)src/' work); positionals also
                             work — `--` is only needed for paths starting
                             with '-'. A scoped run also
                             suppresses the summary: it describes the whole
                             repo, not your scope. A trailing bare `--` alone
                             is inert (same output as no arguments).
  -h                         Show this help (`--help` routes to git's man
                             page — parent-spec dispatcher behavior)

DESCRIPTION:
  Lists staged and unstaged files with color-coded status prefixes
  (S:Mod, U:Del, ...), optionally untracked files, then prints the
  one-line `hug s` summary. Positional arguments are pathspecs, exactly
  like `git status -- <pathspec>...`: files matching no pathspec are
  filtered out.

PATH FILTERING:
  Append -- <path>... to restrict output to matching paths.
  Globs must be quoted; see 'hug help :pathspec' for the full contract.

  hug sl -- src/                 # only tracked changes under src/
  hug sla -- '*.md'              # tracked + untracked Markdown files

EXAMPLES:
  hug sl                         # staged + unstaged, then summary
  hug sla                        # also list untracked files
  hug sl -- src/                 # only src/, no trailing summary
  hug sl -- ':(exclude)src/'     # everything EXCEPT src/
  hug sla -c                     # just the matching file count
  hug statusbase --long -- docs/ # untracked included, docs/ only
EOF
}

# Parse arguments to determine what to show.
# NOTE: parsing runs BEFORE check_git_repo so `-h` works from any cwd and
# help_search.py can index this script (`<script> --help` → show_help,
# exit 0) — same ordering as git-slc / git-w-wip.
include_untracked=false
json_output=false
quiet=false
count_only=false
pathspecs=()

# Uniform pathspec split (#292 PR-B): flags before '--', pathspecs after it —
# see parse_common_flags_with_pathspecs in hug-cli-flags for the contract.
# WITHOUT --picker on purpose: statusbase is a listing, so a trailing bare
# '--' must stay inert (summary parity), never open an interactive picker.
eval "$(parse_common_flags_with_pathspecs "$@")"

# parse_common_flags CONSUMED -q and exported HUG_QUIET — rehydrate the local
# AFTER the split (also covers a pre-set HUG_QUIET environment).
[[ ${HUG_QUIET:-} == T ]] && quiet=true

# Seed the ONE pathspec collection with the split's post-'--' data first;
# pre-arg positionals join it in the own-loop below. Order is irrelevant —
# git unions pathspecs — but there must be exactly ONE array so the summary
# suppression and every sink read the same scope.
pathspec_pathspecs_into pathspecs

# Own-loop over the pre-args only: statusbase's accepted pre-'--' grammar.
# The gitconfig aliases (`sl = statusbase -uno`, `sla = statusbase --long`)
# arrive here as pre-args, so -uno/--long MUST stay in this grammar.
# Unknown tokens are ONLY the -* class — bare positionals collect as
# pathspecs (git parity: 'hug sl src/' filters today and keeps filtering).
for arg in "$@"; do
  case "$arg" in
  --long | -u | --untracked-files=all)
    include_untracked=true
    ;;
  -uno | --untracked-files=no)
    include_untracked=false
    ;;
  --json)
    json_output=true
    ;;
  -c | --count)
    count_only=true
    ;;
  -*)
    # Loud by contract (was: silent pathspec swallow — '-xX' used to become a
    # filter matching nothing, exit 0). exit 2 = HUG_EX_USAGE.
    # The remedy names `hug sl`, not this script: users reach this loop as
    # `hug sl`/`hug sla` (gitconfig aliases), and `hug sl -- <tok>` is the
    # spelling they can actually type — same family template as git-sls.
    error_usage "Unknown option: $arg. Pathspecs beginning with '-' require '--': hug sl -- $arg. See 'hug help :pathspec'."
    ;;
  *)
    pathspecs+=("$arg")
    ;;
  esac
done

# Early exit if not in Git repo (after parsing — see show_help note above)
check_git_repo

# Build list_files_with_status options
list_opts=("--staged" "--unstaged")
if $include_untracked; then
  list_opts+=("--untracked")
fi

# Add pathspecs behind the protective '--' (Task 5 lib surgery landed).
# HISTORY (#292 PR-B review, probed): this site used to pass pathspecs RAW —
# list_files_with_status's option loop was separator-BLIND, so a caller-side
# '--' neither protected (the loop still matched a pathspec named '--cwd'
# as an option) NOR was inert (it became a phantom positive pathspec that
# emptied ':(exclude)'-only scoping, verified against the git oracle). The
# Task 5 surgery made the selector-level loop separator-aware, so the
# protective '--' is now the CORRECT spelling: honored as a separator,
# consumed (never a phantom), and a pathspec spelled like an option stays
# data (`hug sl -- --cwd` scopes to a file literally named '--cwd').
if [[ ${#pathspecs[@]} -gt 0 ]]; then
  list_opts+=("--" "${pathspecs[@]}")
fi

# TODO list files sorted by reverse status text (so that `S:*` files appear last, closer to the cursor line after the command has finished printing a lot of lines. The second field to sort should be the file path.

# Count mode: -c/--count dispatch (see run_count_mode in hug-select-files).
# --json passed only when $json_output is true (the codebase stores booleans as
# true/false strings; ${json_output:+--json} would ALWAYS expand — see run_count_mode).
if $count_only; then
  if $include_untracked; then _slc_state=all+untracked; else _slc_state=all; fi
  # Protective '--' here too (Task 5 lib surgery): count_files_with_status
  # now HONORS a separator right after its state enum, so the '--' is
  # consumed rather than riding into git as a phantom positive pathspec.
  # Nullsafe ${arr[@]+...} form: expands to nothing when the array is empty.
  if $json_output; then
    run_count_mode --json "$_slc_state" ${pathspecs[@]+"--" "${pathspecs[@]}"}
  else
    run_count_mode "$_slc_state" ${pathspecs[@]+"--" "${pathspecs[@]}"}
  fi
fi

# JSON output mode
if $json_output; then
  output_json_status "${list_opts[@]}"
else
  # Show enhanced file list if there are any changes
  if ! list_files_with_status "${list_opts[@]}" 2> /dev/null; then
    # No files found - show appropriate message
    if $include_untracked; then
      if [[ ${#pathspecs[@]} -gt 0 ]]; then
        pathspec_list=""
        printf -v pathspec_list "'%s' " "${pathspecs[@]}"
        info "No staged, unstaged, or untracked files matching ${pathspec_list% } found."
      else
        info "No staged, unstaged, or untracked files."
      fi
    else
      if [[ ${#pathspecs[@]} -gt 0 ]]; then
        pathspec_list=""
        printf -v pathspec_list "'%s' " "${pathspecs[@]}"
        info "No staged or unstaged files matching ${pathspec_list% } found."
      else
        info "No staged or unstaged files."
      fi
    fi
  fi

  # Sink 4 (#292 spec §3.1, family-wide): the trailing whole-repo 'hug s' summary is suppressed iff
  # pathspecs are active (array-non-empty, NOT '--'-seen — the inert bare '--'
  # keeps summary parity with the unfiltered run: a scoped run's whole-repo
  # summary would misdescribe the scope). Script scope — NO 'local' here
  # (Bash: "can only be used in a function"; under set -e that error kills
  # every non-quiet listing).
  if ! $quiet && [[ ${#pathspecs[@]} -eq 0 ]]; then
    exec hug s
  fi
fi
