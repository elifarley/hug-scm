#!/usr/bin/env bash
_hug_category='["staging"]'
_hug_keywords='["add", "stage", "track"]'
test "${1:-}" = '--search-meta' && {
  printf 'category = %s\nkeywords = %s\n' "$_hug_category" "$_hug_keywords"
  exit 0
}
# Assume HUG_HOME is set (exported by hug or environment)
# shellcheck source=git-config/lib/hug-common
. "$HUG_HOME/git-config/lib/hug-common"
# shellcheck source=git-config/lib/hug-git-kit
. "$HUG_HOME/git-config/lib/hug-git-kit"
# shellcheck source=git-config/lib/hug-file-input
. "$HUG_HOME/git-config/lib/hug-file-input"
# shellcheck source=git-config/lib/hug-select-files
. "$HUG_HOME/git-config/lib/hug-select-files"
set -euo pipefail # Exit on error, undefined vars, pipe failures

# Stage files and print a one-line index summary.
# WHY (elifarley/hug-scm#207): an agent running `hug a file.txt` after a
# soft-reset has no signal that the index was already populated with N other
# files from the reset. The summary surfaces the cumulative count at the
# moment the user can still act on it (unstage, inspect, abort) — making
# this the PREVENTION counterpart to hug c's RECOVERY preview (Task 2).
#
# Design notes:
# - Uses `git diff-files --name-only` (working tree vs index) before/after
#   to count files whose staged content actually changed — this correctly
#   reports restaging (editing an already-staged file and running `hug a`
#   again) whereas a naive `git diff --cached --name-only | wc -l` diff
#   would report "Staged 0 files" (elifarley/hug-scm#210).
# - HUG_QUIET gate lives HERE (this is a git-a-specific helper, NOT a
#   shared library function). Shared helpers like print_list must NOT check
#   HUG_QUIET internally — see eng review finding E1.
# - Removing `exec` from the four exit paths means the script continues
#   after `git add` rather than replacing the process. The summary prints
#   after git add returns, then the script exits naturally.
#
# Usage: hug_add_with_summary <git add args...>
hug_add_with_summary() {
  # Snapshot all "not-yet-in-index" files before git add:
  #   - git diff-files: tracked files with working-tree changes
  #   - git ls-files --others: untracked files
  # Files that vanish from this union after the add are the ones actually
  # staged — this correctly counts restaging (editing an already-staged
  # file) and first-time staging of untracked files (elifarley/hug-scm#210).
  local _pool_before _pool_after
  _pool_before=$({
    git diff-files --name-only 2> /dev/null
    git ls-files --others --exclude-standard 2> /dev/null
  } |
    sort)

  # Run the actual git add (forward all args VERBATIM, honor errors under
  # set -e). NO separator heuristic here (review #3800343262): a first-arg
  # guard cannot know whether '-A' is an option the user meant ('hug a foo
  # -A' — git-legal, options may follow paths) or a filename; only a call
  # site that has CLASSIFIED its arguments as data may insert '--'.
  git add "$@"

  _pool_after=$({
    git diff-files --name-only 2> /dev/null
    git ls-files --others --exclude-standard 2> /dev/null
  } |
    sort)

  # Files that left the pool = actually staged (restaged or newly added).
  local _staged=0
  if [[ -n "$_pool_before" ]]; then
    _staged=$(comm -23 <(printf '%s\n' "$_pool_before") \
      <(printf '%s\n' "${_pool_after:-}") |
      wc -l | tr -d ' ')
  fi

  # Index total after the add (pathnames with diff vs HEAD).
  local _index_after
  _index_after=$(git diff --cached --name-only 2> /dev/null | wc -l | tr -d ' ')

  # Print summary to stderr, suppressed by HUG_QUIET.
  if [[ -z "${HUG_QUIET:-}" ]]; then
    printf 'Staged %d file%s. %d staged total now.\n' \
      "$_staged" "$([[ $_staged -eq 1 ]] && echo '' || echo 's')" "$_index_after" >&2
  fi
}

# Part of the Hug tool suite

show_help() {
  cat << 'EOF'
hug a: Stage tracked files, or specific files if provided.

USAGE:
  hug a                # Stage tracked changes: modifications + deletions (not new files)
  hug a .              # Stage current directory
  hug a <file>         # Stage specific files
  hug a --             # Interactive file selection (current directory scope)
  hug a -- <path>... -- # Interactive file selection, scoped to the given pathspecs
  hug a --browse-root  # Interactive file selection (full repository scope)
  hug a --from-file <file>     # Stage files from list file or stdin
  hug a --from-commit <commit> # Stage files changed in specified commit

OPTIONS:
  --             Trigger interactive file selection UI
  --browse-root  Browse full repository scope in file selector UI (default: current directory)
  --from-file <file>    Read file list from file or stdin (use '-' for stdin)
  --from-commit <commit> Use files changed in the specified commit
  -q, --quiet    Suppress the post-stage summary (sets HUG_QUIET=T)
  -h, --help     Show this help message and exit.

DESCRIPTION:
  Stage tracked files for commit. When no arguments are provided, stages all
  tracked changes: modifications AND deletions, but not new/untracked files
  (this is 'git add -u'; use 'hug aa' to also include new files). Note: giving
  an explicit path, e.g. 'hug a <dir>', DOES stage untracked files under it.
  Use '--' to interactively select
  files to stage. By default, interactive selection is scoped to the current
  directory and subdirectories. Use --browse-root to browse the entire repository.

  The --from-file flag reads file names from a file or stdin. It intelligently
  parses both simple file lists (one per line) and the output from 'hug sh'.

  The --from-commit flag directly extracts files from a commit's changes,
  providing an optimized workflow for staging the same files as a previous commit.

PATH FILTERING:
  Append -- <path>... to restrict output to matching paths.
  Globs must be quoted; see 'hug help :pathspec' for the full contract.

  hug a -- file.txt              # stage exactly this file
  hug a -- src/ --               # interactive picker scoped to src/

EXAMPLES:
  hug a --from-file files.txt          # Stage files from list
  hug a --from-commit HEAD~1           # Stage files from previous commit
  hug sh HEAD~2 | hug a --from-file -   # Stage files from hug sh output

SEE ALSO:
  hug aa: Stage everything (tracked + untracked + deletions)
  hug ai: Invoke interactive add menu
  hug ap: Add patches interactively (no commit)
EOF
}

# Parse custom flags (excluding -- which will be handled by parse_common_flags)
from_file=""
from_commit=""
remaining_args=()

while [[ $# -gt 0 ]]; do
  case "$1" in
  --from-file)
    [[ $# -ge 2 ]] || {
      error "--from-file requires a value."
      exit 2
    }
    from_file="$2"
    shift 2
    ;;
  --from-commit)
    [[ $# -ge 2 ]] || {
      error "--from-commit requires a value."
      exit 2
    }
    from_commit="$2"
    shift 2
    ;;
  --browse-root)
    # Roast F-002: this flag was documented but DEAD — the catch-all below
    # collected it into remaining_args and 'git add --browse-root' died
    # (exit 129). Replicates parse_common_flags' semantics here because the
    # custom loop consumes args it must not re-forward.
    browse_root=true
    export HUG_INTERACTIVE_FILE_SELECTION=true
    shift
    ;;
  -h | --help)
    show_help
    exit 0
    ;;
  -q | --quiet)
    export HUG_QUIET=T
    shift
    ;;
  --)
    # Don't process -- here, let parse_common_flags handle it
    break
    ;;
  *)
    remaining_args+=("$1")
    shift
    ;;
  esac
done

# Parse common flags via the uniform pathspec contract (#292/#298 Task 9):
# parse_common_flags_with_pathspecs owns BOTH the trailing-bare-'--' picker
# trigger (--picker mode) and the first-'--' split, so the picker arm below
# can scope its candidates via forward_pathspecs_to_picker. Equivalence with
# the pre-Task-9 parse_common_flags call (judged by reading both parsers):
# the custom loop above breaks at the FIRST '--', so the helper only ever
# sees the tail beginning there — its split carries exactly what the old
# residual "$@" carried in every shape ('-- f', '-- f --', bare '--',
# 'f --', no-separator).
eval "$(parse_common_flags_with_pathspecs --picker "$@")"

# #297 fix: post-'--' positionals are FILES. Re-collect them SEPARATELY
# (not into remaining_args) or 'hug a -- file' falls through to the zero-args
# arm — silently staging 'git add -u' (everything tracked-modified) instead
# of the named file. The two-arm dispatch keeps different contracts:
# pre-'--' positionals still live in remaining_args (custom loop), preserving
# today's loud pass-through ('hug a -xX' → git's exit-129 unknown switch,
# pinned by a characterization row), while post-'--' positionals are pure
# data behind a protective '--', read through pathspec_pathspecs_into (the
# single read path for the split).
post_separator_args=()
pathspec_pathspecs_into post_separator_args

# Initialize common flag variables if not set by parse_common_flags
: "${browse_root:=false}"

# --browse-root parity with parse_common_flags: explicit paths are an error
if $browse_root; then
  if [[ ${#remaining_args[@]} -gt 0 || ${#post_separator_args[@]} -gt 0 ]]; then
    error "--browse-root cannot be used with explicit paths. Use --browse-root alone for interactive file selection."
    exit 1
  fi
fi

# Early exit if not in Git repo
check_git_repo

# Handle file input flags
if [[ -n "$from_file" || -n "$from_commit" ]]; then
  files=()
  files_from_source=()

  if [[ -n "$from_commit" ]]; then
    mapfile -t files_from_source < <(extract_files_from_commit "$from_commit")
  elif [[ -n "$from_file" ]]; then
    # Command substitution, NOT '< <(…)' (code-roast MINOR): the process
    # substitution swallowed read_files_from_source's exit — its error()
    # exited only the SUBSHELL and the caller continued with an empty
    # list. '$(…) || exit $?' keeps the failure fatal.
    from_source_out=""
    from_source_out=$(read_files_from_source "$from_file") || exit $?
    if [[ -n "$from_source_out" ]]; then
      mapfile -t files_from_source <<< "$from_source_out"
    fi
  fi

  # Compose git's grammar exactly (roast F-001 + review #3800343262 compose):
  # pre-separator pass-through args keep option reachability BEFORE the
  # separator; source-derived lines and post-separator args are CLASSIFIED
  # DATA after it — a from-file list line literally named '-A' must stage
  # that file, never run 'git add -A' over the whole tree.
  if [[ ${#files_from_source[@]} -eq 0 && ${#remaining_args[@]} -eq 0 && ${#post_separator_args[@]} -eq 0 ]]; then
    info "No files to stage."
    exit 0
  fi

  hug_add_with_summary ${remaining_args[@]+"${remaining_args[@]}"} -- ${files_from_source[@]+"${files_from_source[@]}"} ${post_separator_args[@]+"${post_separator_args[@]}"}
  exit 0
fi

# Handle interactive file selection if requested
if [[ "${HUG_INTERACTIVE_FILE_SELECTION:-}" = "true" ]]; then
  # Get list of files with changes (including untracked files)
  declare -a select_opts=("--multi" "--unstaged" "--untracked")

  # Default to --cwd (current directory scope) unless --browse-root is specified
  if ! $browse_root; then
    select_opts+=("--cwd")
  fi

  select_opts+=("--prompt" "Select files to stage...")

  # Scoped picker (#292/#298 Task 9): pathspecs between the FIRST '--' and
  # the trailing picker '--' ('hug a -- src/ --') scope the candidate list —
  # previously they were silently discarded here (contract §2 rule 1). The
  # helper appends them behind a protective '--' so a pathspec spelled like
  # a picker option ('--cwd') stays data. Post-pick rule: the picked files
  # REPLACE the pathspecs on the git add line below — git unions positive
  # pathspecs, so keeping both would widen the scope back out.
  #
  # Validate BEFORE the picker (codex P2): the picker's listing helpers
  # suppress git's failure, so a malformed magic pathspec ('a -- :(bogus)src/ --')
  # becomes an empty candidate list — exit 0, nothing staged, no diagnosis —
  # while the direct (no-picker) arm propagates git's own fatal. Loud here
  # too. No-ops on an empty list (helper contract, hug-git-files).
  validate_pathspecs_or_die ${_pathspec_pathspecs[@]+"${_pathspec_pathspecs[@]}"}
  forward_pathspecs_to_picker select_opts

  files=()
  if ! mapfile -t files < <(select_files_with_status "${select_opts[@]}"); then
    info "No files selected or cancelled."
    exit 0
  fi

  if [ ${#files[@]} -eq 0 ]; then
    info "No files selected."
    exit 0
  fi

  # Selector output is classified data (a picked file named '-A' is a
  # filename, never git add's --all) — one separator, no heuristic.
  hug_add_with_summary -- ${files[@]+"${files[@]}"}
  exit 0
fi

# Check if no arguments - stage all tracked modified files
if [[ ${#remaining_args[@]} -eq 0 && ${#post_separator_args[@]} -eq 0 ]]; then
  hug_add_with_summary -u
  exit 0
fi

if [[ ${#post_separator_args[@]} -gt 0 ]]; then
  # A separator was used — git's own grammar 'git add [<options>] [--]
  # <pathspec>...': pre-separator positionals keep their option
  # reachability (a '-A' BEFORE '--' is an option, as in raw git), and the
  # classified post-separator data follows ONE '--' (a '-A' AFTER '--' is
  # a filename — 'hug a -- -A' stages that file, never the whole tree).
  hug_add_with_summary ${remaining_args[@]+"${remaining_args[@]}"} -- "${post_separator_args[@]}"
else
  # No separator: verbatim pass-through (options stay options — 'hug a foo
  # -A' is git-add-legal; unknown dash tokens fail LOUD, exit 129, pinned)
  hug_add_with_summary ${remaining_args[@]+"${remaining_args[@]}"}
fi
