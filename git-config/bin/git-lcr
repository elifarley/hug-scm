#!/usr/bin/env bash
_hug_category='["history"]'
test "${1:-}" = '--search-meta' && {
  printf 'category = %s\n' "$_hug_category"
  exit 0
}
CMD_BASE="$(readlink -f "$0" 2> /dev/null || greadlink -f "$0")" || CMD_BASE="$0"
CMD_BASE="$(dirname "$CMD_BASE")"
for f in hug-common hug-git-kit; do . "$CMD_BASE/../lib/$f"; done
set -euo pipefail

show_help() {
  cat << 'EOF'
hug lcr: Search commits by RegEx CODE CHANGES in diff.

USAGE:
    hug lcr <regex> [-i] [-p] [--all] [-- [<file>]] [--browse-root] [-h, --help]

ARGUMENTS:
    <regex>        Regular expression to search for in code changes (required)
    <file>         Restrict search to specific file (optional)

OPTIONS:
    -i             Ignore case when searching
    -p             Show patches
    --all          Consider ALL branches (not just current)
    --browse-root  Browse full repository scope in file selector UI (default: current directory)
    -- <file>      Restrict search to specific file
    -- (last arg)  Restrict search with interactive file selection (current directory scope)
    -h, --help     Show this help

DESCRIPTION:
    Searches for commits where the specified regular expression pattern
    matches changes in the diff. This is useful for finding when code
    matching a pattern was introduced or changed.
    By default, interactive selection is scoped to the current directory and
    subdirectories. Use --browse-root to browse the entire repository.

EXAMPLES:
    hug lcr "function.*User"        # Find commits with function definitions
    hug lcr "TODO|FIXME" -i         # Case-insensitive pattern search
    hug lcr "import.*from" -p       # Show patches for matches
    hug lcr "class \w+" -- src/     # Search in specific directory
    hug lcr "class \w+" --          # Search with interactive file selection (current directory)
    hug lcr "class \w+" --browse-root  # Search with interactive file selection (full repository)

SEE ALSO:
    hug lf       : Search commits by message
    hug lc       : Search commits by code changes (literal text)
    hug llf      : Log commits for file
    hug shc      : File change statistics for found commits
EOF
}

# Parse common flags + split pathspecs at the first '--' (uniform pathspec
# contract, #292). '--picker' opts into the trailing-bare-'--' interactive
# flow: the helper owns that lifecycle and re-exports
# HUG_INTERACTIVE_FILE_SELECTION only for '--picker' + trailing '--'.
# Caller-scope effects: "$@" = separator-free pre-args; _pathspec_pathspecs =
# pathspec data after the first '--'. browse_root is still set by the
# delegated parse_common_flags (only when --browse-root is present).
eval "$(parse_common_flags_with_pathspecs --picker "$@")"

# Initialize common flag variables if not set by parse_common_flags
: "${browse_root:=false}"

check_git_repo

# Check if regex pattern provided
if [ $# -eq 0 ]; then
  show_help
  exit 1
fi

regex_pattern="$1"
shift

# Handle interactive file selection if requested
if [[ "${HUG_INTERACTIVE_FILE_SELECTION:-}" = "true" ]]; then
  # Show interactive file selection
  if gum_available; then
    declare -a select_opts=("--single")

    # Default to --cwd (current directory scope) unless --browse-root is specified
    if ! $browse_root; then
      select_opts+=("--cwd")
    fi

    select_opts+=("--prompt" "Select file to restrict search...")

    # Forward the user's pathspecs to the picker (same idiom as
    # hug-git-diff): without this, the picker offers out-of-scope files and
    # silently discards the requested scope (#292).
    if [[ ${#_pathspec_pathspecs[@]} -gt 0 ]]; then
      select_opts+=("${_pathspec_pathspecs[@]}")
    fi

    file=""
    if file=$(select_files_with_status "${select_opts[@]}"); then
      # The picked file joins the user's pathspecs under ONE separator: a
      # second `--` after a first would become a path literally named '--'.
      exec hug ll -G "$regex_pattern" "$@" -- ${_pathspec_pathspecs[@]+"${_pathspec_pathspecs[@]}"} "$file"
    else
      info "Cancelled."
      exit 0
    fi
  else
    error "Interactive file selection requires 'gum' to be installed.
Usage: hug lcr <regex> [options] -- <file>
Install gum: https://github.com/charmbracelet/gum"
  fi
fi

# Re-inject the separator nullsafe (#292 BUG-2): `${arr[@]+...}` expands to
# nothing for an empty array, so no lone `--` is added when the user passed
# no pathspecs.
exec hug ll -G "$regex_pattern" "$@" ${_pathspec_pathspecs[@]+"--" "${_pathspec_pathspecs[@]}"}
