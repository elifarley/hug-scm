#!/usr/bin/env bash
_hug_category='["files"]'
test "${1:-}" = '--search-meta' && {
  printf 'category = %s\n' "$_hug_category"
  exit 0
}
CMD_BASE="$(readlink -f "$0" 2> /dev/null || greadlink -f "$0")" || CMD_BASE="$0"
CMD_BASE="$(dirname "$CMD_BASE")"
for f in hug-common hug-git-kit; do . "$CMD_BASE/../lib/$f"; done
set -euo pipefail

show_help() {
  cat << 'EOF'
hug fa: Count commits per author for a file.

USAGE:
    hug fa [<file>] [-h, --help]
    hug fa --browse-root

ARGUMENTS:
    <file>          File to analyze (optional - prompts for selection if omitted)

OPTIONS:
    --browse-root   Browse full repository scope in file selector UI (default: current directory)
    -h, --help      Show this help

DESCRIPTION:
    Shows the number of commits each author has made to a file, sorted by
    commit count (most active first). Follows renames through history.
    By default, interactive selection is scoped to the current directory and
    subdirectories. Use --browse-root to browse the entire repository.

EXAMPLES:
    hug fa                      # Interactive file selection (current directory)
    hug fa --browse-root        # Interactive file selection (full repository)
    hug fa src/app.js           # Count commits per author for specific file

SEE ALSO:
    hug fblame   : Show who changed what line
    hug fb       : Short blame (author and line only)
    hug fcon     : List all contributors to a file
EOF
}

# Parse common flags + split at -- (uniform pathspec contract, #310 thread
# #3834674457): WITHOUT --picker. The split owns the separator so a
# dash-leading file via '--' stays DATA, and unknown pre-'--' options survive
# into "$@" where the loud check below rejects them (parse_common_flags
# passes them through by design — previously they were tallied as FILES and
# 'hug fa src/a.py --bogus' reported "got 2 files", a false count).
eval "$(parse_common_flags_with_pathspecs "$@")"

# Initialize common flag variables if not set by parse_common_flags
: "${browse_root:=false}"

check_git_repo

# If no file provided, show interactive selection or error.
# Separator-aware (#310 #3834674457): post-'--' candidates live in
# _pathspec_pathspecs, not "$@" — count them too, or 'fa -- README.md'
# would wrongly take the no-args branch.
if [ $# -eq 0 ] && ! { [[ ${_pathspec_pathspecs[*]+x} && ${#_pathspec_pathspecs[@]} -gt 0 ]]; }; then
  # Only show interactive selection if gum is available
  if gum_available; then
    declare -a select_opts=("--single")

    # Default to --cwd (current directory scope) unless --browse-root is specified
    if ! $browse_root; then
      select_opts+=("--cwd")
    fi

    select_opts+=("--prompt" "Select file to count commits per author...")

    file=""
    if ! file=$(select_files_with_status "${select_opts[@]}"); then
      info "No file selected or cancelled."
      exit 0
    fi
    git log --follow --format='%an' -- "$file" | sort | uniq -c | sort -rn
    exit 0
  else
    # Fall back to error when gum is not available
    error "File argument required. Install 'gum' for interactive file selection.
Usage: hug fa <file>
Install gum: https://github.com/charmbracelet/gum"
  fi
fi

# --browse-root excludes explicit paths (same regression class codex
# #3834674453 caught on h-steps, ship-review coverage audit found here):
# the split hides post-'--' paths from parse_common_flags' enforcement, so
# 'fa --browse-root -- src/a.py' analyzed the file with the flag silently
# ignored where main rejected loudly. Message/exit mirror the lib's own
# rejection; fires before the guards below (main's precedence).
if $browse_root && { [[ $# -gt 0 ]] || { [[ ${_pathspec_pathspecs[*]+x} && ${#_pathspec_pathspecs[@]} -gt 0 ]]; }; }; then
  error "--browse-root cannot be used with explicit paths. Use --browse-root alone for interactive file selection."
fi

# Cardinality + unknown-option guard (pathspec contract §3.2, #310 thread
# #3834674457): fa analyzes ONE file. Two-stream tally — pre-'--' tokens are
# candidates (unknown -* among them is a loud usage error, not a "file"),
# post-'--' tokens are DATA by contract (a dash-named file via '--' must
# reach the truthful cardinality reject, never an option-parse complaint).
# The surviving candidate is re-pointed onto "$@" so the exec line below
# stays untouched.
# Pre-'--' stream: collect, then LOUDLY check — BEFORE any separator data
# joins (adversarial F2: checking post-merge misclassified separator DATA
# spelled '-name' as an option; 'fa -- -dash.txt' must analyze, matching
# h-steps and fblame). Empty-string positionals are usage errors too
# (adversarial F1: 'fa "" extra' silently analyzed nothing, exit 0).
file_candidates=()
for f in "$@"; do
  if [[ -z "$f" ]]; then
    error_usage "Empty file argument."
  fi
  if [[ -z "${file:-}" ]]; then
    file="$f"
  else
    file_candidates+=("$f")
  fi
done
for f in ${file_candidates[@]+"${file_candidates[@]}"}; do
  if [[ "$f" == -* ]]; then
    error_usage "Unknown option: $f. See 'hug help :pathspec'."
  fi
done
if [[ -n "${file:-}" && "$file" == -* ]]; then
  error_usage "Unknown option: $file. See 'hug help :pathspec'."
fi

# Post-'--' stream: EVERY token is DATA by contract — no option re-parse.
if [[ ${_pathspec_pathspecs[*]+x} && ${#_pathspec_pathspecs[@]} -gt 0 ]]; then
  for f in ${_pathspec_pathspecs[@]+"${_pathspec_pathspecs[@]}"}; do
    if [[ -z "${file:-}" ]]; then
      file="$f"
    else
      file_candidates+=("$f")
    fi
  done
fi
reject_multiple_files "hug fa" "$file" ${file_candidates[@]+"${file_candidates[@]}"}
set -- ${file:+"$file"}

exec git log --follow --format='%an' -- "$@" | sort | uniq -c | sort -rn
