#!/usr/bin/env bash
_hug_category='["head"]'
test "${1:-}" = '--search-meta' && {
  printf 'category = %s\n' "$_hug_category"
  exit 0
}
CMD_BASE="$(readlink -f "$0" 2> /dev/null || greadlink -f "$0")" || CMD_BASE="$0"
CMD_BASE="$(dirname "$CMD_BASE")"
for f in hug-common hug-git-kit; do . "$CMD_BASE/../lib/$f"; done
set -euo pipefail

show_help() {
  cat << EOF
hug h steps: Show commit steps back from HEAD to last change of a file.

USAGE:
    hug h steps [<file>] [--raw] [--quiet] [--browse-root] [-h, --help]

ARGUMENTS:
    <file>          File to analyze (optional - prompts for selection if omitted)

OPTIONS:
    --raw           Output just the step count (0 if in HEAD)
    --quiet         Suppress output (sets HUG_QUIET=T)
    --browse-root   Browse full repository scope in file selector UI (default: current directory)
    -h, --help      Show this help

DESCRIPTION:
    Computes the number of commits from HEAD back to the most recent commit
    touching <file> (handles renames via --follow). Use to find N for 'h back N'
    or similar HEAD ops.

    When no file is provided, displays an interactive file selection menu.
    By default, interactive selection is scoped to the current directory and
    subdirectories. Use --browse-root to browse the entire repository.

    Full output: "<steps> steps back from HEAD; <formatted commit info>"
    If 0 steps: Indicates last change is in HEAD.

EXAMPLES:
    hug h steps                     # Interactive file selection (current directory)
    hug h steps --browse-root       # Interactive file selection (full repository)
    hug h steps src/app.js          # Full info for app.js
    hug h steps README.md --raw     # Just the number (e.g., 3)
    hug h steps file.txt --raw | xargs hug h back  # Chain to rewind

SEE ALSO:
    h back    : Make HEAD walk back some commits while keeping their changes staged
    llf       : Log commits for file
EOF
}

# Parse common flags + split at -- (uniform pathspec contract, #302 C-004)
# WITHOUT --picker (h-steps is not a picker) but the split still owns the
# separator so a dash-leading file via -- is visible as pathspec data.
eval "$(parse_common_flags_with_pathspecs "$@")"

# Initialize common flag variables if not set by parse_common_flags
: "${browse_root:=false}"

# saw_separator: true iff a -- separator was consumed and left pathspec data
# (infer from the shell-wide _pathspec_pathspecs populated by the split above;
# trailing bare -- alone is stripped before the split and leaves it empty).
saw_separator=false
if [[ ${_pathspec_pathspecs[*]+x} && ${#_pathspec_pathspecs[@]} -gt 0 ]]; then
  saw_separator=true
fi
# Merge pre-args ($@ holds them post-split) and separator-protected pathspecs
# into one argument stream for the own-loop. --raw is consumed here before any
# guard, so 'hug h steps README.md --raw' (help:44) is not misread as an
# unknown flag; a dash-leading file that arrived via -- stays data.
if [[ ${_pathspec_pathspecs[*]+x} && ${#_pathspec_pathspecs[@]} -gt 0 ]]; then
  set -- "$@" ${_pathspec_pathspecs[@]+"${_pathspec_pathspecs[@]}"}
fi

# Parse custom flags
file=""
raw=false
extra_files=()
while [[ $# -gt 0 ]]; do
  case "$1" in
  --raw)
    raw=true
    shift
    ;;
  *)
    # Cardinality contract (#292, spec §3.2): the OLD loop silently broke on
    # the second positional — `hug h steps a b` analyzed `a` and vanished
    # `b` without a word. Keep collecting so reject_multiple_files can name
    # the mistake instead of hiding it.
    if [[ -z "$file" ]]; then
      file="$1"
    else
      extra_files+=("$1")
    fi
    shift
    ;;
  esac
done
# Cardinality + unknown-flag guard (#302 C-004, codex #3829676849, #3830105470):
# h-steps's own-loop *) arm collects unknown -* tokens (parse_common_flags
# passes them through) into file/extra_files, so 'hug h steps a --bogus'
# used to be miscounted as a file and fire the cardinality guard. Filtering it
# from the tally alone would have turned a typo into silent success, violating
# the path-command contract that unknown flags must fail (exit 2).
# NOT the pre-loop slice (collect_positional_args_before_flags): --raw
# legitimately follows the file ('hug h steps README.md --raw', help:44) and
# is consumed by the own-loop's --raw arm first, so the loop must run in full.
# Fix: (1) loud unknown-flag check first — EXEMPT a dash-leading file that
# arrived via -- (hug h steps -- -foo.txt creates _pathspec_pathspecs[-foo.txt]
# after parse_common_flags_with_pathspecs; the separator-protected file is not
# an "unknown option"), then (2) cardinality on files-only.
for f in ${extra_files[@]+"${extra_files[@]}"}; do
  if [[ "$f" == -* ]]; then
    error_usage "Unknown option: $f. See 'hug help :pathspec'."
  fi
done
if [[ -n "${file:-}" && "$file" == -* && "${saw_separator:-false}" != true ]]; then
  error_usage "Unknown option: $file. See 'hug help :pathspec'."
fi
reject_files=()
[[ -n "${file:-}" ]] && reject_files+=("$file")
for f in ${extra_files[@]+"${extra_files[@]}"}; do
  reject_files+=("$f")
done
reject_multiple_files "hug h steps" ${reject_files[@]+"${reject_files[@]}"}

# If no file provided, show interactive selection or help
if [[ -z "$file" ]]; then
  # Only show interactive selection if gum is available
  if gum_available; then
    declare -a select_opts=("--single")

    # Default to --cwd (current directory scope) unless --browse-root is specified
    if ! $browse_root; then
      select_opts+=("--cwd")
    fi

    select_opts+=("--prompt" "Select file to analyze...")

    if ! file=$(select_files_with_status "${select_opts[@]}"); then
      info "No file selected or cancelled."
      exit 0
    fi
  else
    # Fall back to showing help when gum is not available
    show_help
    exit 1
  fi
fi

check_git_repo
if [ ! -e "$file" ]; then
  error "File '$file' does not exist."
  exit 1
fi

last_commit=$(git log -1 --follow --format=%H -- "$file" 2> /dev/null) || {
  error "File '$file' has no commits in history (untracked or new)."
  exit 1
}

steps=$(git rev-list --count "$last_commit"..HEAD)

if $raw; then
  echo "$steps"
  exit 0
fi

short_hash=$(git rev-parse --short "$last_commit")
if [ "$steps" = "0" ]; then
  echo "0 steps back from HEAD (last change in current commit);" >&2
  hug ll -1
else
  echo "$steps steps back from HEAD (last commit $short_hash);" >&2
  hug ll "$last_commit" -1
fi
