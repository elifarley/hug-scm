#!/usr/bin/env bash
_hug_category='["head"]'
test "${1:-}" = '--search-meta' && {
  printf 'category = %s\n' "$_hug_category"
  exit 0
}
CMD_BASE="$(readlink -f "$0" 2> /dev/null || greadlink -f "$0")" || CMD_BASE="$0"
CMD_BASE="$(dirname "$CMD_BASE")"
for f in hug-common hug-git-kit; do . "$CMD_BASE/../lib/$f"; done
set -euo pipefail

show_help() {
  cat << EOF
hug h steps: Show commit steps back from HEAD to last change of a file.

USAGE:
    hug h steps [<file>] [--raw] [--quiet] [--browse-root] [-h, --help]

ARGUMENTS:
    <file>          File to analyze (optional - prompts for selection if omitted)

OPTIONS:
    --raw           Output just the step count (0 if in HEAD)
    --quiet         Suppress output (sets HUG_QUIET=T)
    --browse-root   Browse full repository scope in file selector UI (default: current directory)
    -h, --help      Show this help

DESCRIPTION:
    Computes the number of commits from HEAD back to the most recent commit
    touching <file> (handles renames via --follow). Use to find N for 'h back N'
    or similar HEAD ops.

    When no file is provided, displays an interactive file selection menu.
    By default, interactive selection is scoped to the current directory and
    subdirectories. Use --browse-root to browse the entire repository.

    Full output: "<steps> steps back from HEAD; <formatted commit info>"
    If 0 steps: Indicates last change is in HEAD.

EXAMPLES:
    hug h steps                     # Interactive file selection (current directory)
    hug h steps --browse-root       # Interactive file selection (full repository)
    hug h steps src/app.js          # Full info for app.js
    hug h steps README.md --raw     # Just the number (e.g., 3)
    hug h steps file.txt --raw | xargs hug h back  # Chain to rewind

SEE ALSO:
    h back    : Make HEAD walk back some commits while keeping their changes staged
    llf       : Log commits for file
EOF
}

# Parse common flags + split at -- (uniform pathspec contract, #302 C-004)
# WITHOUT --picker (h-steps is not a picker) but the split still owns the
# separator so a dash-leading file via -- is visible as pathspec data.
eval "$(parse_common_flags_with_pathspecs "$@")"

# Initialize common flag variables if not set by parse_common_flags
: "${browse_root:=false}"

# Two-stream design (roast F-002 on #310): post-'--' tokens stay SEPARATE from
# the pre-arg stream — the separator changes delivery, never meaning (#292), so
# they are file candidates by definition and must never be re-parsed as options.
# (The earlier draft merged _pathspec_pathspecs back onto "$@" before the own-
# loop; that destroyed per-token origin, so only the FIRST pathspec could be
# exempted from the unknown-flag check and 'hug h steps -- -foo.txt -bar.txt'
# rejected the second dash-named file as "Unknown option" — probed.)
# Pre-args keep their own loop: unknown -* there stays a loud usage error
# ('hug h steps src/a.py --bogus' must not silently succeed, #302 C-004);
# --raw is consumed here before any guard ('hug h steps README.md --raw',
# help:44).
file=""
raw=false
extra_files=()
while [[ $# -gt 0 ]]; do
  case "$1" in
  --raw)
    raw=true
    shift
    ;;
  *)
    # Cardinality contract (#292, spec §3.2): collect extras instead of
    # silently dropping them — reject_multiple_files names the mistake.
    if [[ -z "$file" ]]; then
      file="$1"
    else
      extra_files+=("$1")
    fi
    shift
    ;;
  esac
done

# Unknown PRE-'--' flags are loud: filtering them from the tally alone would
# have turned a typo into silent success (the path-command contract, exit 2).
# This check MUST run before the separator candidates below join the tally —
# at this point file/extra_files hold pre-arg tokens only, so any -* there is
# genuinely an unknown option; post-'--' data is exempt by construction.
for f in ${extra_files[@]+"${extra_files[@]}"}; do
  if [[ "$f" == -* ]]; then
    error_unknown_option "$f"
  fi
done
if [[ -n "$file" && "$file" == -* ]]; then
  error_unknown_option "$file"
fi

# --browse-root excludes explicit paths (#310 codex #3830105477-adjacent,
# thread #3834674453): parse_common_flags enforces this invariant, but the
# pathspec split HIDES post-'--' paths from it — 'h steps --browse-root --
# src/a.py' analyzed the file with the flag silently ignored (a regression
# vs main's loud reject; probed). The check must see the separator data too.
# Message/exit mirror parse_common_flags' own rejection (error, exit 1) and
# main's precedence (this check fires before the cardinality guard).
if $browse_root && { [[ -n "$file" || ${#extra_files[@]} -gt 0 ]] || pathspecs_nonempty; }; then
  error "--browse-root cannot be used with explicit paths. Use --browse-root alone for interactive file selection."
fi

# Separator-protected candidates: EVERY token after '--' is data (even one
# spelled like a flag). Feed them straight into the cardinality tally — no
# option re-parse, no exemption logic to forget.
if pathspecs_nonempty; then
  for sep_file in ${_pathspec_pathspecs[@]+"${_pathspec_pathspecs[@]}"}; do
    if [[ -z "$file" ]]; then
      file="$sep_file"
    else
      extra_files+=("$sep_file")
    fi
  done
fi

reject_multiple_files "hug h steps" "$file" ${extra_files[@]+"${extra_files[@]}"}

# If no file provided, show interactive selection or help
if [[ -z "$file" ]]; then
  # Only show interactive selection if gum is available
  if gum_available; then
    declare -a select_opts=("--single")

    # Default to --cwd (current directory scope) unless --browse-root is specified
    if ! $browse_root; then
      select_opts+=("--cwd")
    fi

    select_opts+=("--prompt" "Select file to analyze...")

    if ! file=$(select_files_with_status "${select_opts[@]}"); then
      info "No file selected or cancelled."
      exit 0
    fi
  else
    # Fall back to showing help when gum is not available
    show_help
    exit 1
  fi
fi

check_git_repo
if [ ! -e "$file" ]; then
  error "File '$file' does not exist."
  exit 1
fi

last_commit=$(git log -1 --follow --format=%H -- "$file" 2> /dev/null) || {
  error "File '$file' has no commits in history (untracked or new)."
  exit 1
}

steps=$(git rev-list --count "$last_commit"..HEAD)

if $raw; then
  echo "$steps"
  exit 0
fi

short_hash=$(git rev-parse --short "$last_commit")
if [ "$steps" = "0" ]; then
  echo "0 steps back from HEAD (last change in current commit);" >&2
  hug ll -1
else
  echo "$steps steps back from HEAD (last commit $short_hash);" >&2
  hug ll "$last_commit" -1
fi
