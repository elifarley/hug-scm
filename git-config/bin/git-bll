#!/usr/bin/env bash
_hug_category='["branching"]'
test "${1:-}" = '--search-meta' && {
  printf 'category = %s\n' "$_hug_category"
  exit 0
}
CMD_BASE="$(readlink -f "$0" 2> /dev/null || greadlink -f "$0")" || CMD_BASE="$0"
CMD_BASE="$(dirname "$CMD_BASE")"
for f in hug-common hug-git-kit output_json_branch_list; do . "$CMD_BASE/../lib/$f"; done # Load common constants and functions
set -euo pipefail                                                                         # Exit on error, undefined vars, pipe failures

# Part of the Hug tool suite

show_help() {
  cat << 'EOF'
hug bll: List local branches in long format, showing short hash, date, upstream tracking info, and commit message title for each.

USAGE:
  hug bll [OPTIONS] [SEARCH_TERM]

OPTIONS:
  -h, --help     Show this help message and exit.
  --json         Output in JSON format instead of human-readable text.
  --newest       Sort by commit date with the most recent FIRST (default: most
                 recent at bottom). Matches 'hug wtl --sort recent' semantics.

DESCRIPTION:
  Displays each local branch sorted by commit date (oldest first, most recent at bottom;
  see --newest to flip). The current branch is highlighted in green and marked with an asterisk (*).
  Each entry shows: branch name (short hash YYYY-MM-DD) [upstream tracking info, e.g., origin/main ahead 2].
  The commit message title follows.
  Remote tracking information is shown just as in 'git branch -vv'.

  If a search term is provided, only branches containing the term (case-insensitive substring match on branch name) are displayed.

EXAMPLES:
  hug bll           # List all local branches in long format (most recent at bottom)
  hug bll --newest  # Most recent branch first
  hug bll fix       # List branches containing "fix"

SEE ALSO:
  hug bl : For listing local branches in short form
  hug b  : For switching branches
EOF
}

# Parse arguments
json_output=false
newest_first=false
while [[ $# -gt 0 ]]; do
  case "$1" in
  --json)
    json_output=true
    shift
    ;;
  --newest)
    newest_first=true
    shift
    ;;
  -h | --help)
    show_help
    exit 0
    ;;
  *)
    # Treat remaining arguments as search terms
    break
    ;;
  esac
done

# Capture search terms
search_terms="$*"

# Early exit if not in Git repo
check_git_repo

# JSON output mode
if $json_output; then
  # Get current branch for JSON
  current_branch=$(git branch --show-current 2> /dev/null || echo "detached HEAD")
  # --newest must reach JSON too, so both output modes agree on ordering.
  $newest_first && output_json_branch_list "$current_branch" newest && exit 0
  output_json_branch_list "$current_branch"
  exit 0
fi

# Get branch details from Python module. Default ascending (oldest first,
# recent at bottom); --newest flips to descending (most recent first).
sort_flag=--ascending
$newest_first && sort_flag=--sort-context=gum-multi
if ! eval "$(python3 "$CMD_BASE/../lib/python/hug_git_branch.py" local "$sort_flag")"; then
  printf "No local branches found.\n" >&2
  exit 1
fi

# Print non-interactive list (display functions now include dates)
print_branch_list "$current_branch" "$max_len" hashes dates branches tracks subjects "$search_terms"
