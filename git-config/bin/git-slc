#!/usr/bin/env bash
_hug_category='["status"]'
_hug_keywords='["conflict","unmerged","merge","rebase"]'
test "${1:-}" = '--search-meta' && {
  printf 'category = %s\nkeywords = %s\n' "$_hug_category" "$_hug_keywords"
  exit 0
}
CMD_BASE="$(readlink -f "$0" 2> /dev/null || greadlink -f "$0")" || CMD_BASE="$0"
CMD_BASE="$(dirname "$CMD_BASE")"
for f in hug-common hug-git-kit hug-select-files output_json_status hug-status-listing; do . "$CMD_BASE/../lib/$f"; done
set -euo pipefail

# Part of the Hug tool suite

# Show only conflicted (unmerged) files, then summary

show_help() {
  cat << 'EOF'
hug slc: Show only conflicted (unmerged) files.
One-word answer to 'which files are in conflict?' during a merge or rebase.

USAGE:
  hug slc [OPTIONS] [pathspec...]

OPTIONS:
  -c, --count       Print only the number of matching files (the grep -c
                    of listings): a single integer, 0 when none, exit 0.
                    Suppresses the trailing summary. Mutually exclusive
                    with --json.
  -q, --quiet       Print plain paths only (no status column, no summary).
  --json            Output the unified JSON envelope (pathspecs scope the
                    envelope; an empty scope keeps the envelope shape with
                    zero counts).
  -- <path>...       Pathspecs scope the listing (git magic pathspecs like
                    ':(exclude)src/' work); positionals also work — `--` is
                    only needed for paths starting with '-'. A trailing
                    bare `--` alone is inert (same output as no arguments).
  -h, --help        Show this help message and exit.

DESCRIPTION:
  Lists each conflicted (unmerged) file with the Cnflt prefix — the same
  primitive as `git diff --diff-filter=U`, which lists every unmerged file
  exactly once (no dedup needed) and surfaces unmerged gitlinks.
  Positional arguments are pathspecs, exactly like `git status --
  <pathspec>...`: files matching no pathspec are filtered out — from the
  text listing AND from the --json envelope.

PATH FILTERING:
  Append -- <path>... to restrict output to matching paths.
  Globs must be quoted; see 'hug help :pathspec' for the full contract.

  hug slc -- src/                 # only conflicts under src/
  hug slc --json -- ':(glob)src/**/*.py'  # scoped JSON envelope

EOF
}

sl_family_main conflicts "hug slc" "$@"
