#!/usr/bin/env bash
_hug_category='["committing"]'
test "${1:-}" = '--search-meta' && {
  printf 'category = %s\n' "$_hug_category"
  exit 0
}
CMD_BASE="$(readlink -f "$0" 2> /dev/null || greadlink -f "$0")" || CMD_BASE="$0"
CMD_BASE="$(dirname "$CMD_BASE")"
for f in hug-common hug-git-kit hug-git-worktree; do . "$CMD_BASE/../lib/$f"; done
set -euo pipefail # Exit on error, undefined vars, pipe failures
# Part of the Hug tool suite

show_help() {
  cat << EOF
hug cmv: Move (relocate) commits from current branch to another branch (new or existing).

USAGE:
    hug cmv [N|COMMIT] <target-branch> [--new] [--wt] [-u, --upstream] [--quiet] [--force]

OPTIONS:
    [N|COMMIT]      Number of commits to move (default: 1) or specific commit to move above
    <target-branch> Required: Branch to move commits to
    --new           Create <target-branch> if it doesn't exist (from the move target commit)
    --wt            Ensure the target branch has a worktree: create one if missing,
                    otherwise reuse the existing one. The move is performed in/for
                    that worktree and you stay on the source branch.
    -u, --upstream  Move local-only commits above upstream tip instead of [N|COMMIT]
    --quiet         Suppress output (sets HUG_QUIET=T)
    --force         Skip confirmation prompts (use with caution)
    -y, --yes       Skip confirmation prompts (keeps safe semantics)

DESCRIPTION:
    Moves the specified commits from the current branch to <target-branch> by detaching (new branches) or cherry-picking (existing) and resetting the current branch back. Preserves individual commit history. If <target-branch> missing without --new, prompts to create (auto-creates with --force). Use --new for explicit non-interactive creation.

    For new branches: Creates pointer at original HEAD then resets source back (exact history preserved, original SHAs kept, no conflicts possible).
    For existing branches: Cherry-picks the range onto target (creates NEW commit SHAs, may conflict).

    With -u, moves local-only commits above the upstream remote tip (read-only preview/confirmation; no fetch).

    Requires a clean working tree and index (no staged or unstaged changes; untracked ok). Cannot mix -u with [N|COMMIT]. Aborts on cherry-pick conflicts (existing branches) or if <target-branch> can't be checked out.

    Previews are organized: 📊 summary + changes, followed by 📤 commit list (shown once).

    RECOVERY: cmv is its own inverse. After a successful move, run the printed
    inverse command to move the commits back (see the post-op hint). For new
    branches SHAs are preserved; for existing branches the inverse cherry-picks
    new SHAs. Requires an undrifted tree and knowing N + the original branch.
    To copy commits without modifying the source branch, use 'hug ccp' instead.

COMMON SCENARIOS:
    # Accidentally committed to wrong branch
    hug cmv 3 feature/api-refactor --new    # Move last 3 commits to new feature branch

    # Move tested commits from feature branch to main
    hug cmv 6 main                          # Move 6 commits to existing main branch

    # Extract experimental work to separate branch
    hug cmv 2 experiment/perf-test --new    # Keep experimenting without cluttering main

    # Consolidate unpushed commits to proper branch
    hug cmv -u feature/cleanup              # Move local-only commits to cleanup branch

EXAMPLES:
    hug cmv 2 feature/new --new     # Move last 2 commits to new branch 'feature/new'
    hug cmv a1b2c3 existing-branch  # Move commits above a1b2c3 to 'existing-branch'
    hug cmv -u feature/local        # Move local-only commits to 'feature/local'
    hug cmv 3 bugfix --force        # Skip confirmation

CONFLICT RESOLUTION:
    If cherry-pick fails due to conflicts on existing branches:

    Manual approach (recommended):
        hug b <target-branch>       # Switch to target branch
        hug ccp <commit-range>      # Cherry-pick commits step-by-step
        # Resolve conflicts interactively as they occur

    Alternative using git rebase:
        git rebase --onto <target> <base> <source-branch>
        # Follow interactive prompts to resolve conflicts

    Note: Conflicts only occur with existing branches. New branches preserve exact history (no conflicts possible).

SEE ALSO:
    hug ccp       Copy commits instead of moving
    hug h back    Move HEAD back without relocating
    hug b         Branch management
    hug rbi       Interactive rebase for complex history editing
EOF
}

# Parse common flags (--quiet, --force, -h|--help)
eval "$(parse_common_flags "$@")"

# Parse custom flags
upstream=false
new_branch=false
new_branch_passed=false # True ONLY when --new was explicitly on the CLI.
# Distinct from $new_branch, which the missing-branch
# resolve path also sets true after a danger prompt.
# Used by the --wt block to decide whether the move's
# danger prompt still needs to fire.
wt=false # --wt: ensure target branch has a worktree (create if missing).
target_arg=""
branch_name=""
while [[ $# -gt 0 ]]; do
  case "$1" in
  -u | --upstream)
    upstream=true
    shift
    ;;
  --new)
    new_branch=true
    new_branch_passed=true
    shift
    ;;
  --wt)
    wt=true
    shift
    ;;
  *)
    if [[ -z "$target_arg" ]]; then
      target_arg="$1"
    elif [[ -z "$branch_name" ]]; then
      branch_name="$1"
    else error "Unexpected argument: $1"; fi
    shift
    ;;
  esac
done

if [[ -z "$branch_name" ]]; then
  # Special case: if using -u and target_arg is set, it's actually the branch name
  if $upstream && [[ -n "$target_arg" ]]; then
    branch_name="$target_arg"
    target_arg=""
  else
    error "Missing required <target-branch>."
  fi
fi

if $upstream && [[ -n "$target_arg" ]]; then
  error "Cannot specify both --upstream and [N|COMMIT]."
fi

check_git_repo

# Require clean working tree and index (unified tracked-dirty check)
if has_uncommitted_tracked_changes; then
  error "Require clean tracked working tree and index to proceed (unstaged or staged tracked changes; untracked ok). Tracked changes would be lost during reset."
fi

original_branch=$(git branch --show-current)
if [[ -z "$original_branch" ]]; then
  error "Must be on a branch to move commits. (Detached HEAD not supported.)"
fi
original_head=$(git rev-parse HEAD)

if $upstream; then
  target=$(handle_upstream_operation "moving" "danger" "cmv" "moves commits to another branch and rewrites SHAs; not auto-recoverable") || exit $?
  if [[ -z "${target:-}" ]]; then
    exit 0
  fi
else
  # Special case: if target_arg is "0", immediately exit with message
  if [[ "${target_arg:-}" == "0" ]]; then
    info "No commits to move (target is 0)."
    exit 0
  fi
  target=$(resolve_head_target "${target_arg:-}" 'HEAD~1')
  # Validate that the target is a valid commit before proceeding
  validate_commitish "cmv target" "$target"
fi

# Resolve target to actual SHA (important: do this before reset changes HEAD)
target=$(git rev-parse "$target")

# Early calculation for commits to relocate (for 0-commit early exit and prompts).
# cmv's target MUST be an ancestor ("specific commit to move above", "reset branch back"),
# so == 0 is the correct vacuous-op no-op — do NOT migrate this to is_same_commit (a forward
# target is an incoherent cmv request, and falling through would hard-reset the branch
# FORWARD + switch branch on a 'NOT RESTORABLE' command). Strict: a bad ref now fails
# loudly instead of masquerading as '0 commits'. The OLD message lied ('already at target')
# for a descendant target; branch on is_same_commit so BOTH sub-cases are truthful (a commit is
# its own ancestor — equality-as-ancestry — so 'is not an ancestor' would lie when aligned).
commits_to_relocate=$(count_commits_in_range "$target" HEAD) || exit 1
if [ "$commits_to_relocate" -eq 0 ]; then
  if is_same_commit "$target" HEAD; then
    info "No commits to move (already at $(git rev-parse --short "$target"))."
  else
    info "No commits to move (target $(git rev-parse --short "$target") is a descendant of HEAD; cmv needs an ancestor target)."
  fi
  exit 0
fi
commit_word="commit"
if [ "$commits_to_relocate" -gt 1 ]; then
  commit_word="commits"
fi

# Check branch existence
branch_exists=true
is_new_branch=false
if ! git rev-parse --verify "$branch_name" > /dev/null 2>&1; then
  branch_exists=false
  if ! $new_branch; then
    if [[ ${HUG_FORCE:-} == true ]]; then
      if [[ ${HUG_QUIET:-} != T ]]; then
        printf 'Branch %s missing; auto-creating with --force from target %s.\n' "$branch_name" "$(git rev-parse --short "$target")" >&2
      fi
      new_branch=true # Enable creation logic
      is_new_branch=true
    else
      # Combined prompt for creation + move
      if prompt_confirm_danger "cmv" "moves commits to another branch and rewrites SHAs; not auto-recoverable"; then
        new_branch=true
        is_new_branch=true
      else
        info "Cancelled."
        exit 0
      fi
    fi
  else
    # --new was explicitly specified
    is_new_branch=true
  fi
fi

# Centralized unified preview (after branch decision, before existing-branch confirmation)
target_short=$(git rev-parse --short "$target")
range_for_diff="$target..HEAD"
if [[ ${HUG_QUIET:-} != T ]]; then
  print_preview_summary "$commits_to_relocate" "$commit_word" "$target_short" "$range_for_diff"
  print_commit_list_header "moving" "$branch_name" "$is_new_branch" "false"
  print_commit_list_in_range "$target" HEAD >&2
  printf '\n' >&2
fi

# For existing branches, count and confirm move (new branches already handled above)
if $branch_exists; then
  # Confirmation (only if --force not set; tree is clean, so always skip prompt if force)
  should_prompt=true
  if [[ ${HUG_FORCE:-} == true ]]; then
    should_prompt=false
  fi

  if $should_prompt; then
    prompt_confirm_danger "cmv" "moves commits to another branch and rewrites SHAs; not auto-recoverable"
  fi
fi

# --- --wt path: ensure target branch has a worktree, then perform the move
# there and LEAVE THE USER ON THE SOURCE BRANCH. Branch+worktree creation is
# safe-tier; the move itself is danger-tier. Confirm-first: every prompt is
# gathered before any mutation.
#
# Ordering rationale: for existing branches we cherry-pick into the worktree
# FIRST (tree is clean there), then reset the source — never the reverse, or
# the cherry-pick range "$target..$original_head" would be unreachable after
# the source's HEAD moves back. For new branches, the helper creates the
# branch at $original_head so no cherry-pick is needed; the source's own
# reset is independent.
#
# NOTE: `local` is ILLEGAL here — this is top-level script scope, not a
# function (bash errors: "local: can only be used in a function"). Plain
# underscore-prefixed vars keep them out of the user's environment namespace.
if $wt; then
  # Danger-tier move prompt. Confirm-first means: gather every prompt
  # BEFORE mutating anything. By the time we reach here, the existing
  # cmv flow has already prompted in three of the four shapes:
  #   - existing branch (incl. --new on an existing branch): the confirm
  #     block just above this.
  #   - missing branch, no --new:  the resolve block above (which exits
  #                                on decline — so reaching here means
  #                                the user accepted).
  #   - -u:                        handle_upstream_operation.
  # The ONLY shape that arrives unconfirmed is `--new` on a MISSING
  # branch (the resolve block's `else` set is_new_branch=true without
  # prompting). $new_branch_passed && ! $branch_exists is the
  # discriminator for that case.
  if $new_branch_passed && ! $branch_exists && [[ ${HUG_FORCE:-} != true ]] && ! $upstream; then
    prompt_confirm_danger "cmv" "moves commits to another branch and rewrites SHAs; not auto-recoverable"
  fi

  # Reuse the worktree if the branch already has one; otherwise create it.
  _resolved_wt=""
  if $branch_exists; then
    # get_worktree_path_by_branch returns 1 with empty output when no
    # worktree holds the branch — tolerate that without aborting.
    _resolved_wt=$(get_worktree_path_by_branch "$branch_name") || _resolved_wt=""
  fi

  if [[ -z "$_resolved_wt" ]]; then
    # IMPORTANT (set -e discipline): a bare `x=$(func ...); rc=$?`
    # ABORTS at the assignment when the helper exits non-zero, so rc
    # is never captured. The `if ! x=$(func); then rc=$?; exit; fi`
    # form is the only safe shape under `set -e`.
    #
    # --base is passed ONLY for the new-branch case so the helper
    # creates the branch at the exact original_head SHA (preserving
    # history). For existing branches we omit --base; the helper
    # refuses it anyway (it errors when the branch already exists).
    # Build the --base arg conditionally. We can't use the `$( ... && echo )`
    # trick for two-word output (it would either drop the value or mangle
    # quoting), so assemble into a positional array instead.
    _cmv_wt_create_args=("$branch_name")
    if ! $branch_exists; then
      _cmv_wt_create_args+=(--base "$original_head")
    fi
    if [[ ${HUG_FORCE:-} == true ]]; then
      _cmv_wt_create_args+=(--force)
    fi
    if ! _helper_out=$(create_worktree_for_branch "${_cmv_wt_create_args[@]}"); then
      _create_rc=$?
      exit "$_create_rc"
    fi
    # Helper prints three tab-separated fields to stdout:
    # RESOLVED_PATH <TAB> CREATED_BRANCH <TAB> DRY_RUN. cmv consumes
    # only the path; the other two are for --json consumers (wtc).
    IFS=$'\t' read -r _resolved_wt _created_dummy _dry_dummy <<< "$_helper_out"
  fi

  # Pick-then-reset (see ordering rationale in the block header above).
  if $branch_exists; then
    # The cherry-pick happens in a LINKED worktree the user may not have in
    # mind. Under set -e a conflict would abort the script with raw git output
    # and leave that worktree mid-CHERRY_PICKING — disorienting and unrecoverable
    # without a hint. Wrap it: on failure, point the user at the worktree and
    # tell them exactly how to finish or abort. The source branch is untouched
    # at this point (the rewind happens AFTER this block succeeds), so we can
    # truthfully say "source unchanged" in the warning.
    if ! git -C "$_resolved_wt" cherry-pick "$target".."$original_head"; then
      warning "Cherry-pick conflict in worktree '$_resolved_wt'."
      warning "Source branch '$original_branch' is unchanged."
      tip "Resolve in worktree: cd $_resolved_wt && hug ccp $target..$original_head"
      tip "Or abort: git -C $_resolved_wt cherry-pick --abort"
      exit 1
    fi
  fi
  # Source branch rewound to target. The clean-tree gate at line ~142
  # guarantees no tracked changes to lose; untracked files survive.
  git reset --hard "$target"

  test "${HUG_QUIET:-f}" = T && exit

  info "Moved $commits_to_relocate $commit_word to '$branch_name' (worktree: $_resolved_wt). Still on '$original_branch'."
  tip "Recovery: cd $_resolved_wt && hug cmv $commits_to_relocate $original_branch --wt"
  # Skip the non-wt tail below (the legacy cmv flow): we've already reset
  # the source and the user stays on $original_branch (we never checked
  # out the target branch).
  exit 0
fi

# Reset original branch to target (safe since tree/index clean)
git checkout -q "$original_branch"
if [[ ${HUG_QUIET:-} == T ]]; then
  git reset --hard "$target" > /dev/null 2>&1
else
  git reset --hard "$target"
fi

# Handle creation or existing
if ! $branch_exists && $new_branch; then
  # Simple detach for new branch: create pointing to original HEAD
  git branch "$branch_name" "$original_head"
else
  # Existing branch: use temp for cherry-pick
  temp_branch="hug-move-temp-$(git rev-parse --short "$original_head")"
  git branch "$temp_branch" "$original_head"
  git checkout -q "$branch_name"
  git cherry-pick "$target".."$temp_branch"
  git branch -D "$temp_branch"
fi

# Stay on target branch
git checkout -q "$branch_name"

test "${HUG_QUIET:-f}" = T && exit

if ! $branch_exists && $new_branch; then
  info "Created and moved $commits_to_relocate $commit_word to new branch '$branch_name'. Now on '$branch_name'."
else
  info "Moved $commits_to_relocate $commit_word to '$branch_name'. Now on '$branch_name'."
fi
tip "Commits relocated. Continue working on '$branch_name'."
