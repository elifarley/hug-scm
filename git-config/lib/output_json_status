#!/usr/bin/env bash
# Helper function for JSON status output
# Used by git-statusbase command

# Load JSON utilities
CMD_BASE="$(readlink -f "$0" 2> /dev/null || greadlink -f "$0")" || CMD_BASE="$0"
CMD_BASE="$(dirname "$CMD_BASE")"
. "$CMD_BASE/../lib/hug-json"
# Argument-surgery helpers (drain_pathspecs_after_separator — #292 PR-B
# Task 7 extraction). Loaded at FILE scope so the parse loop inside
# output_json_status can call the drain before the lazy hug-git-json source
# further down. Re-sourcing is safe: hug-cli-flags' _HUG_CLI_FLAGS_LOADED
# guard makes a second load a no-op (it MUST — a re-source would otherwise
# wipe _pathspec_pathspecs, breaking any caller that already parsed).
. "$CMD_BASE/../lib/hug-cli-flags"

output_json_status() {
  local include_staged=false
  local include_unstaged=false
  local include_untracked=false
  local include_ignored=false
  local include_conflicts=false
  local scope_cwd=false
  local -a pathspecs=()

  # Parse arguments
  # Separator-aware (#292 Task 6): everything after '--' is a pathspec — a
  # token shaped like one of our own flags (a file literally named '--cwd')
  # is DATA and must scope the listing, never toggle the flag above. Mirrors
  # list_staged_files' '--' arm (hug-git-files). Exact-one-'--' rule: this
  # layer CONSUMES the separator it receives and re-appends exactly one at
  # the output_json_status_unified boundary below.
  while [[ $# -gt 0 ]]; do
    case "$1" in
    --staged)
      include_staged=true
      shift
      ;;
    --unstaged)
      include_unstaged=true
      shift
      ;;
    --untracked)
      include_untracked=true
      shift
      ;;
    --ignored)
      include_ignored=true
      shift
      ;;
    --conflicts)
      include_conflicts=true
      shift
      ;;
    --cwd)
      scope_cwd=true
      shift
      ;;
    --)
      shift
      drain_pathspecs_after_separator pathspecs "$@"
      break
      ;;
    *)
      shift
      ;;
    esac
  done

  # Load unified JSON library
  . "$CMD_BASE/../lib/hug-git-json"

  # Build filter types
  local filter_types=""
  if $include_staged; then
    filter_types+="staged,"
  fi
  if $include_unstaged; then
    filter_types+="unstaged,"
  fi
  if $include_untracked; then
    filter_types+="untracked,"
  fi
  if $include_ignored; then
    filter_types+="ignored,"
  fi
  if $include_conflicts; then
    filter_types+="conflicted,"
  fi

  # Remove trailing comma if any
  filter_types="${filter_types%,}"

  # Build unified arguments (library version excludes empty arrays)
  local -a unified_args=()

  if [[ -n "$filter_types" ]]; then
    unified_args+=("--filter" "$filter_types")
  fi

  if $scope_cwd; then
    unified_args+=("--cwd-only")
  fi

  # Re-append exactly ONE separator before the collected pathspecs (the one
  # the caller sent was consumed by the parse loop above). Nullsafe: a bare
  # trailing '--' with no pathspecs forwards nothing.
  if [[ ${#pathspecs[@]} -gt 0 ]]; then
    unified_args+=("--" "${pathspecs[@]}")
  fi

  # Call unified function
  output_json_status_unified "${unified_args[@]}"
}
