# Lists all tracked files (in the index)
# Usage: mapfile -t files < <(list_tracked_files [--cwd] [--] [pathspecs...])
# Parameters:
#   --cwd - If provided, scopes listing to current directory and subdirectories only
#   pathspecs - Optional git pathspecs to filter files (wildcards, directories, file patterns)
# Output:
#   File paths relative to current directory (one per line)
# Notes:
#   When --cwd is NOT specified, lists all files in repository by running from repo root.
#   When --cwd IS specified, lists files in current directory and subdirectories.
#   Pathspecs REPLACE the '.' cwd scope, not AND with it — git pathspecs are
#   already cwd-relative, so forwarding them verbatim preserves the
#   cwd-relative output contract while honoring the requested scope.
#   Uses git ls-files to list index contents (excludes untracked).
#   Includes unchanged tracked files.
#   Empty output if no tracked files (new repo).
list_tracked_files() {
    local scope_cwd=false
    if [[ "${1:-}" == "--cwd" ]]; then
        scope_cwd=true
        shift
    fi
    # A leading '--' ends flag parsing: the selector forwards one to keep
    # option-shaped pathspecs (a file literally named '--cwd') out of our
    # flag slot. Strip it — everything after is a pathspec.
    [[ "${1:-}" == "--" ]] && shift

    check_git_repo

    # Optional trailing pathspecs (git-style, #292): when present they
    # REPLACE the cwd '.' scope — git pathspecs are already cwd-relative,
    # so forwarding them verbatim keeps the output contract (cwd-relative
    # paths) intact while honoring the requested scope.
    local -a scopes=()
    if [[ $# -gt 0 ]]; then
        scopes=("$@")
    elif $scope_cwd; then
        scopes=(".")
    fi

    local -a paths=()
    if [[ ${#scopes[@]} -gt 0 ]]; then
        mapfile -t paths < <(git ls-files -- "${scopes[@]}" 2>/dev/null || true)
    else
        # Browse full repository: run ls-files from repo root
        local repo_root
        repo_root="$(git rev-parse --show-toplevel)"
        mapfile -t paths < <(git -C "$repo_root" ls-files 2>/dev/null || true)
        # Paths are now relative to repo root, convert to current-dir relative
        convert_to_relative_paths paths
    fi

    printf '%s\n' ${paths[@]+"${paths[@]}"}
}
