# shellcheck shell=bash
# This file is a library to be sourced by shell scripts
#
# HUG-GIT-FILES: Git file listing functions
#
# This library provides functions for:
# - Listing files by state (staged, unstaged, untracked, ignored, conflicted, tracked)
# - Optional scoping to current working directory
# - Optional status information
#
# All functions are designed to work with the hug-common library
# and follow consistent patterns for error handling and user feedback.

################################################################################
# Pathspec Validation
################################################################################

# validate_pathspecs_or_die [pathspec...]
# Loud one-time gate for user-supplied pathspecs (#298 roast MAJOR 1).
#
# WHY this exists: git rejects a malformed magic pathspec (e.g. ':(bogus)src/')
# with a fatal + nonzero exit, but every list_*_files capture below suppresses
# stderr and coerces failure to an empty list — the family then presented the
# EMPTY ANSWER ("No staged files matching ':(bogus)src/' found.", exit 0; a
# zero-count JSON envelope) while silently discarding git's fatal. A typo in
# the magic prefix was indistinguishable from a legitimate no-match.
#
# Contract: run ONE unsuppressed `git ls-files -- <specs>` so git's own fatal
# lands on stderr (the precise diagnosis: which magic, which spec), then
# convert the failure into the family's usage-error shape — exit 2
# (HUG_EX_USAGE) + a pointer to 'hug help :pathspec', mirroring the unknown
# '-*' option rejection template.
#
# WHERE to call it: ONCE per invocation, at the COMMAND entry (right after
# check_git_repo), never inside list_*_files / count_files_with_status /
# output_json_status_unified. Two verified traps make the lib level wrong:
#   1. the sl* listing arm calls `list_files_with_status ... 2>/dev/null` —
#      an error() inside would have its message EATEN by the redirect;
#   2. the --json chain collects via `mapfile < <(collect_git_files_json …)`
#      — an error() exits only the process-substitution subshell and the
#      envelope is still printed on stdout.
# Both sinks sit BELOW the command entry, so the entry is the one place the
# exit propagates and stderr stays unsuppressed.
#
# Empty argument list (unscoped run) is byte-identical to today: no git call,
# no output, return 0. A VALID spec set costs exactly one extra git process —
# the price of never answering a typo with a silent empty list.
validate_pathspecs_or_die() {
    [[ $# -gt 0 ]] || return 0
    if ! git ls-files -- "$@" > /dev/null; then
        # git's "fatal: Invalid pathspec magic ..." already reached stderr
        # above (stdout redirected, stderr deliberately unsuppressed) — add
        # only the hug-level remedy, not a duplicate diagnosis.
        local spec_list=""
        printf -v spec_list "'%s' " "$@"
        error_usage "Invalid pathspec: ${spec_list% }. See 'hug help :pathspec'."
    fi
}

