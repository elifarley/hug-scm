# Lists files that are staged (index differs from HEAD)
# Usage: mapfile -t files < <(list_staged_files [--status] [--cwd])
# Parameters:
#   --status - If provided, outputs "status\tfile" (one per line, status like 'M', 'A', 'R100' for renames)
#   --cwd    - If provided, scopes listing to current directory and subdirectories only
# Output:
#   File paths relative to current directory (one per line, or status\tfile if --status)
# Notes:
#   Always converts paths to current-directory-relative via GIT_PREFIX.
#   For renames/copies with --status, outputs the new file path.
#   Empty output if no staged files.
list_staged_files() {
    local with_status=false
    local scope_cwd=false
    local -a pathspecs=()

    # Parse flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --status)
                with_status=true
                shift
                ;;
            --cwd)
                scope_cwd=true
                shift
                ;;
            --)
                # Everything after the separator is a pathspec — even a token
                # shaped like one of our own flags (a file literally named
                # '--cwd' must scope, not toggle the scoping flag). Drained
                # via the shared helper (hug-cli-flags — #292 PR-B Task 7;
                # available here through hug-common's load order).
                shift
                drain_pathspecs_after_separator pathspecs "$@"
                break
                ;;
            *)
                # Treat remaining arguments as pathspecs
                pathspecs+=("$1")
                shift
                ;;
        esac
    done

    check_git_repo

    # Build git command with optional scoping
    # --ignore-submodules=none ensures staged gitlink entries appear even when
    # submodule.*.ignore=all or diff.ignoreSubmodules is set. Without this flag,
    # git treats the staged pointer change as "submodule output" and suppresses it,
    # which violates the user's explicit staging intent (they ran `git add <sub>`).
    local -a git_cmd_base=("git" "diff" "--cached" "--find-renames" "--ignore-submodules=none")
    if $with_status; then
        git_cmd_base+=("--name-status")
    else
        git_cmd_base+=("--name-only")
    fi

    # Add pathspecs if provided, otherwise use directory scoping if requested
    if [[ ${#pathspecs[@]} -gt 0 ]]; then
        git_cmd_base+=("--" "${pathspecs[@]}")
    elif $scope_cwd; then
        git_cmd_base+=("--" ".")
    fi

    if $with_status; then
        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            local status old new file
            IFS=$'\t' read -r status old new <<< "$line"
            if [[ "$status" == R* ]] || [[ "$status" == C* ]]; then
                file="$new"
            else
                file="$old"
            fi
            [[ -z "$file" ]] && continue
            # Always convert to current-dir relative paths
            local -a single=("$file")
            convert_to_relative_paths single
            printf '%s\t%s\n' "$status" "${single[0]}"
        done < <("${git_cmd_base[@]}" 2>/dev/null || true)
    else
        local -a paths=()
        mapfile -t paths < <("${git_cmd_base[@]}" 2>/dev/null || true)
        # Always convert to current-dir relative paths
        convert_to_relative_paths paths
        printf '%s\n' ${paths[@]+"${paths[@]}"}
    fi
}

# Lists unstaged tracked files (working tree differs from index)
# Usage: mapfile -t files < <(list_unstaged_files [--status] [--cwd])
# Parameters:
#   --status - If provided, outputs "status\tfile" (one per line, status like 'M', 'D')
#   --cwd    - If provided, scopes listing to current directory and subdirectories only
# Output:
#   File paths relative to current directory (one per line, or status\tfile if --status)
# Notes:
#   Always converts paths to current-directory-relative via GIT_PREFIX.
#   For potential renames/copies with --status, outputs the relevant file path (future-proof).
#   Empty output if no unstaged files.
list_unstaged_files() {
    local with_status=false
    local scope_cwd=false
    local -a pathspecs=()

    # Parse flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --status)
                with_status=true
                shift
                ;;
            --cwd)
                scope_cwd=true
                shift
                ;;
            --)
                # Everything after the separator is a pathspec — even a token
                # shaped like one of our own flags (a file literally named
                # '--cwd' must scope, not toggle the scoping flag). Drained
                # via the shared helper (hug-cli-flags — #292 PR-B Task 7;
                # available here through hug-common's load order).
                shift
                drain_pathspecs_after_separator pathspecs "$@"
                break
                ;;
            *)
                # Treat remaining arguments as pathspecs
                pathspecs+=("$1")
                shift
                ;;
        esac
    done

    check_git_repo

    # Build git command with optional scoping
    local -a git_cmd_base=("git" "diff" "--find-renames")
    if $with_status; then
        git_cmd_base+=("--name-status")
    else
        git_cmd_base+=("--name-only")
    fi

    # Add pathspecs if provided, otherwise use directory scoping if requested
    if [[ ${#pathspecs[@]} -gt 0 ]]; then
        git_cmd_base+=("--" "${pathspecs[@]}")
    elif $scope_cwd; then
        git_cmd_base+=("--" ".")
    fi

    if $with_status; then
        # Temporary storage for conflict deduplication
        # During merge conflicts, git returns both U (unmerged) and M (modified) for the same file
        # We need to keep only U (conflict) when both exist
        declare -A file_status_map=()

        while IFS= read -r line; do
            [[ -z "$line" ]] && continue
            local status old new file
            IFS=$'\t' read -r status old new <<< "$line"
            if [[ "$status" == R* ]] || [[ "$status" == C* ]]; then
                file="$new"
            else
                file="$old"
            fi
            [[ -z "$file" ]] && continue

            # CONFLICT DEDUPLICATION: U (conflict) takes precedence over M (modified)
            # If file not seen yet, or current status is U (conflict), store this status
            # This ensures that when git returns both M and U for the same file, only U is kept
            if [[ -z "${file_status_map[$file]+_}" ]] || [[ "$status" == "U" ]]; then
                file_status_map[$file]="$status"
            fi
        done < <("${git_cmd_base[@]}" 2>/dev/null || true)

        # Output deduplicated results
        for file in "${!file_status_map[@]}"; do
            local status="${file_status_map[$file]}"
            local -a single=("$file")
            convert_to_relative_paths single
            printf '%s\t%s\n' "$status" "${single[0]}"
        done | sort  # Ensure consistent output order
    else
        local -a paths=()
        mapfile -t paths < <("${git_cmd_base[@]}" 2>/dev/null || true)
        # Always convert to current-dir relative paths
        convert_to_relative_paths paths
        printf '%s\n' ${paths[@]+"${paths[@]}"}
    fi
}

# Lists conflicted (unmerged) files — files with unresolved merge/rebase conflicts
# Usage: mapfile -t files < <(list_conflicted_files [--status] [--cwd] [pathspecs...])
# Parameters:
#   --status - If provided, outputs "status\tfile" (one per line; status is always 'U')
#   --cwd    - If provided, scopes listing to current directory and subdirectories only
#   pathspecs - If provided, filters to only show conflicted files matching pathspecs
# Output:
#   File paths relative to current directory (one per line, or status\tfile if --status)
# Notes:
#   Always converts paths to current-directory-relative via GIT_PREFIX.
#   Uses `git diff --diff-filter=U` — the native "unmerged" filter, verified to list each
#   conflicted file exactly once, so NO dedup map is needed (list_unstaged_files needs its
#   U-over-M map because its unfiltered diff returns both U and M for the same file).
#   No --find-renames (the U filter never produces renames) and no --ignore-submodules=none
#   (unmerged gitlinks bypass submodule-ignore; verified 2026-08-06).
#   Empty output if no conflicts. Exit 0.
list_conflicted_files() {
    local with_status=false
    local scope_cwd=false
    local -a pathspecs=()

    # Parse flags
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --status)
                with_status=true
                shift
                ;;
            --cwd)
                scope_cwd=true
                shift
                ;;
            --)
                # Everything after the separator is a pathspec — even a token
                # shaped like one of our own flags (a file literally named
                # '--cwd' must scope, not toggle the scoping flag). Drained
                # via the shared helper (hug-cli-flags — #292 PR-B Task 7;
                # available here through hug-common's load order).
                shift
                drain_pathspecs_after_separator pathspecs "$@"
                break
                ;;
            *)
                # Treat remaining arguments as pathspecs
                pathspecs+=("$1")
                shift
                ;;
        esac
    done

    check_git_repo

    # Build git command with optional scoping
    local -a git_cmd_base=("git" "diff" "--diff-filter=U")
    if $with_status; then
        git_cmd_base+=("--name-status")
    else
        git_cmd_base+=("--name-only")
    fi

    # Add pathspecs if provided, otherwise use directory scoping if requested
    if [[ ${#pathspecs[@]} -gt 0 ]]; then
        git_cmd_base+=("--" "${pathspecs[@]}")
    elif $scope_cwd; then
        git_cmd_base+=("--" ".")
    fi

    if $with_status; then
        local -a lines=()
        mapfile -t lines < <("${git_cmd_base[@]}" 2>/dev/null || true)
        for line in ${lines[@]+"${lines[@]}"}; do
            [[ -z "$line" ]] && continue
            local status file
            IFS=$'\t' read -r status file <<< "$line"
            [[ -z "$file" ]] && continue
            local -a single=("$file")
            convert_to_relative_paths single
            printf '%s\t%s\n' "$status" "${single[0]}"
        done
    else
        local -a paths=()
        mapfile -t paths < <("${git_cmd_base[@]}" 2>/dev/null || true)
        # Always convert to current-dir relative paths
        convert_to_relative_paths paths
        printf '%s\n' ${paths[@]+"${paths[@]}"}
    fi
}

# Lists untracked files (not in index or .gitignore)
# Usage: mapfile -t files < <(list_untracked_files [--cwd] [pathspecs...])
# Parameters:
#   --cwd - If provided, scopes listing to current directory and subdirectories only
#   pathspecs - If provided, filters to only show untracked files matching pathspecs
# Output:
#   File paths relative to current directory (one per line)
# Notes:
#   Always converts paths to current-directory-relative via GIT_PREFIX.
#   Parses git status --porcelain=v1 -z for ?? entries.
#   Empty output if no untracked files.
#   Preserves special characters in filenames (e.g., spaces, newlines).
list_untracked_files() {
    local scope_cwd=false
    local -a pathspecs=()

    # Parse arguments
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --cwd)
                scope_cwd=true
                shift
                ;;
            --)
                # Everything after the separator is a pathspec — even a token
                # shaped like one of our own flags (a file literally named
                # '--cwd' must scope, not toggle the scoping flag). Drained
                # via the shared helper (hug-cli-flags — #292 PR-B Task 7;
                # available here through hug-common's load order).
                shift
                drain_pathspecs_after_separator pathspecs "$@"
                break
                ;;
            *)
                # Treat remaining arguments as pathspecs
                pathspecs+=("$1")
                shift
                ;;
        esac
    done

    check_git_repo

    # Build git command with optional pathspecs
    local -a git_cmd=("git" "status" "--porcelain=v1" "-z")
    if [[ ${#pathspecs[@]} -gt 0 ]]; then
        git_cmd+=("--" "${pathspecs[@]}")
    elif $scope_cwd; then
        git_cmd+=("--" ".")
    fi

    local -a paths=()
    while IFS= read -r -d '' entry; do
        [[ -z "$entry" ]] && continue
        local status="${entry:0:2}"
        if [[ "$status" == "??" ]]; then
            local file="${entry:3}"
            paths+=("$file")
        fi
    done < <("${git_cmd[@]}" 2>/dev/null || true)

    # Always convert to current-dir relative paths
    convert_to_relative_paths paths
    printf '%s\n' ${paths[@]+"${paths[@]}"}
}

