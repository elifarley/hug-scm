# shellcheck shell=bash
# Library: HUG CLI flag parsing utilities
#
# Shared argument parsing and validation helpers for hug commands.
# Depends on: hug-output for consistent error reporting.
# Requires: GNU getopt
# Functions:
#   - parse_pathspecs: split args at first -- into pre_args and pathspecs.
#   - parse_common_flags: expand shared flags into shell assignments.
#   - parse_common_flags_with_pathspecs: fixed-order combo — pathspec split
#     first, then common-flag parsing on the pre-args only.
#   - pathspec_pathspecs_into: copy the collected pathspecs into a
#     caller-named array (the single read path for the split).
#   - forward_pathspecs_to_picker: append the collected pathspecs to a
#     picker option array behind a protective '--' (nullsafe).
#   - drain_pathspecs_after_separator: the `--)` arm of a separator-aware
#     option loop — append all post-separator tokens to a nameref'd array.
#   - reject_multiple_files: enforce single-file cardinality for
#     one-file commands (uniform pathspec contract, spec §3.2/§5.6).
#   - require_args: enforce minimum argument counts.
#
# Implementation:
#   Uses GNU getopt for robust option parsing (required dependency).

# Double-load guard (#292 PR-B Task 7): downstream libs source this module
# at THEIR file scope (hug-git-json, output_json_status — for the drain
# helper below), and some of those are themselves sourced LAZILY, mid-flow,
# AFTER the caller's split parse (git-lc/git-lf source hug-git-json inside
# their JSON arms). Without the guard, each such re-source re-ran the
# `declare -ga _pathspec_pathspecs=()` below and silently WIPED the
# collected split — probed: lc/lf --json pathspec scoping broke exactly
# this way when the drain extraction first added the sourcing edge. The
# guard turns re-sourcing into a no-op, eliminating the old HAZARD.
if [[ -n "${_HUG_CLI_FLAGS_LOADED:-}" ]]; then
  return 0 2>/dev/null || :
fi
_HUG_CLI_FLAGS_LOADED=1

# Nounset safety (#298): the pathspec global is declared at LOAD time so the
# accessor/forwarder below work before any parse (set -u would kill the shell
# on an unset array expansion). Plain assignment from the parsers' eval'd
# output later just repopulates it. (Re-sourcing no longer wipes it — the
# guard above returns before reaching this declare on any second load.)
declare -ga _pathspec_pathspecs=()

################################################################################
# Command Pattern Helpers
################################################################################

# Splits "$@" at the first -- separator for pathspec-based commands.
#
# MUST run BEFORE parse_common_flags, which intercepts trailing -- for
# interactive file selection. Commands that accept -- <path>... must
# pre-parse pathspecs first, then pass only pre_args to parse_common_flags.
#
# Usage: eval "$(parse_pathspecs "$@")"
# Output (shell code for eval):
#   Sets two arrays in the caller's scope:
#     _pathspec_pre_args   - everything before the first --
#     _pathspec_pathspecs  - everything after the first --
#
# Rules:
#   - Only the FIRST -- splits. Everything after is pathspec data,
#     including literal --help, -foo, or paths named --.
#   - If no -- found, all args go to _pathspec_pre_args
#   - If -- is last arg (bare separator), _pathspec_pathspecs stays empty
#
# Example:
#   parse_pathspecs HEAD -- '*.java' 'src/'
#   → _pathspec_pre_args=(HEAD)  _pathspec_pathspecs=('*.java' 'src/')
parse_pathspecs() {
  local pre_args=()
  local pathspecs=()
  local saw_separator=false

  for arg in "$@"; do
    if $saw_separator; then
      pathspecs+=("$arg")
    elif [[ "$arg" == "--" ]]; then
      saw_separator=true
    else
      pre_args+=("$arg")
    fi
  done

  # Output shell code for eval — always emit both arrays
  printf '_pathspec_pre_args=('
  if [[ ${#pre_args[@]} -gt 0 ]]; then
    printf ' %q' "${pre_args[@]}"
  fi
  printf ' )\n'

  printf '_pathspec_pathspecs=('
  if [[ ${#pathspecs[@]} -gt 0 ]]; then
    printf ' %q' "${pathspecs[@]}"
  fi
  printf ' )\n'
}

# Parses common option flags for command scripts using GNU getopt
# Usage: eval "$(parse_common_flags "$@")"
# Recognizes flags:
#   -y, --yes      Exports HUG_YES=true (skip confirmations, keep safe semantics)
#   --dry-run      Sets dry_run=true
#   -f, --force    Sets force=true, exports HUG_FORCE=true
#   -q, --quiet    Exports HUG_QUIET=T
#   --browse-root  Sets browse_root=true, ALWAYS triggers interactive mode (errors if paths provided)
#   -h, --help     Calls usage or show_help function and exits
#   --             If last argument, sets HUG_INTERACTIVE_FILE_SELECTION=true and removes it
# 
# Benefits of GNU getopt:
#   - Combined short options (e.g., -fq for --force --quiet)
#   - Standard --option=value syntax support
#   - Better error messages for invalid options
#   - Proper handling of edge cases
# 
# Note:
#   Consumes recognized flags from arguments
#   Remaining args can be accessed via "$@" after eval
#   Handles empty remaining args without setting $@ to ("")
#   --browse-root ALWAYS triggers interactive mode and errors if paths are provided
parse_common_flags() {
  local interactive_file_selection=false
  local browse_root_flag=false
  
  # Check if last argument is '--' before processing (for interactive file selection)
  if [[ $# -gt 0 && "${!#}" = "--" ]]; then
    interactive_file_selection=true
    # Remove last argument by creating new array without it
    set -- "${@:1:$(($#-1))}"
  fi
  
  # Verify GNU getopt is available (required dependency)
  if ! { getopt --test >/dev/null 2>&1; [ $? -eq 4 ]; }; then
    echo "echo 'Error: GNU getopt is required but not found. Please install util-linux package.' >&2" >&2
    echo "exit 1"
    return 1
  fi
  
  # Use GNU getopt for enhanced parsing
  local parsed
  # Use -q to suppress getopt error messages, we'll handle them ourselves
  parsed=$(getopt -q --options hfqy --longoptions help,force,quiet,dry-run,browse-root,yes --name "parse_common_flags" -- "$@")
  local getopt_status=$?
  
  # If getopt failed (status 1 = error in parameters), it means unknown options
  # This allows commands to use additional options beyond common flags
  if [ $getopt_status -ne 0 ]; then
    # For commands with additional options, they need to handle their own parsing
    # Just pass through everything as remaining args
    local remaining_args=()
    
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --dry-run)
          echo "dry_run=true"
          shift
          ;;
        -f|--force)
          echo "force=true"
          echo "export HUG_FORCE=true"
          shift
          ;;
        -y|--yes)
          # yes_flag (parse-local) alongside the export: HUG_YES may be
          # INHERITED from the environment (documented sequence-automation
          # variable), so it cannot evidence that THIS invocation passed -y
          # (codex P2 on reject_action_flags).
          echo "yes_flag=true"
          echo "export HUG_YES=true"
          shift
          ;;
        -q|--quiet)
          echo "export HUG_QUIET=T"
          shift
          ;;
        --browse-root)
          echo "browse_root=true"
          browse_root_flag=true
          shift
          ;;
        -h|--help)
          echo "if declare -f show_help >/dev/null; then show_help; fi; exit 0"
          shift
          ;;
        --)
          shift
          remaining_args+=("$@")
          break
          ;;
        *)
          remaining_args+=("$1")
          shift
          ;;
      esac
    done
    
    # Export interactive file selection flag if detected via '--' at end
    if $interactive_file_selection; then
      echo "export HUG_INTERACTIVE_FILE_SELECTION=true"
    fi
    
    # --browse-root ALWAYS triggers interactive mode
    if $browse_root_flag; then
      echo "export HUG_INTERACTIVE_FILE_SELECTION=true"
      # Error if paths are provided with --browse-root
      if [ ${#remaining_args[@]} -gt 0 ]; then
        echo "error '--browse-root cannot be used with explicit paths. Use --browse-root alone for interactive file selection.'"
        echo "exit 1"
      fi
    fi
    
    # Always output set -- to properly update $@ in the caller
    if [ ${#remaining_args[@]} -gt 0 ]; then
      printf 'set -- '
      printf '%q ' "${remaining_args[@]}"
      printf '\n'
    else
      printf 'set --\n'
    fi
    return 0
  fi
  
  eval set -- "$parsed"
  
  # Process parsed options
  while true; do
    case "$1" in
      -h|--help)
        echo "if declare -f show_help >/dev/null; then show_help; fi; exit 0"
        shift
        ;;
      -f|--force)
        echo "force=true"
        echo "export HUG_FORCE=true"
        shift
        ;;
      -y|--yes)
        # yes_flag (parse-local): see the getopt-branch note — HUG_YES may
        # be inherited, only yes_flag evidences THIS invocation passed -y.
        echo "yes_flag=true"
        echo "export HUG_YES=true"
        shift
        ;;
      -q|--quiet)
        echo "export HUG_QUIET=T"
        shift
        ;;
      --dry-run)
        echo "dry_run=true"
        shift
        ;;
      --browse-root)
        echo "browse_root=true"
        browse_root_flag=true
        shift
        ;;
      --)
        shift
        break
        ;;
      *)
        echo "echo 'Internal error in parse_common_flags: unexpected argument \"$(printf %q "$1")\"' >&2" >&2
        echo "exit 1"
        return 1
        ;;
    esac
  done
  
  # Export interactive file selection flag if detected via '--' at end
  if $interactive_file_selection; then
    echo "export HUG_INTERACTIVE_FILE_SELECTION=true"
  fi
  
  # --browse-root ALWAYS triggers interactive mode
  if $browse_root_flag; then
    echo "export HUG_INTERACTIVE_FILE_SELECTION=true"
    # Error if paths are provided with --browse-root
    if [ $# -gt 0 ]; then
      echo "error '--browse-root cannot be used with explicit paths. Use --browse-root alone for interactive file selection.'"
      echo "exit 1"
    fi
  fi
  
  # Output remaining arguments
  if [ $# -gt 0 ]; then
    printf 'set -- '
    printf '%q ' "$@"
    printf '\n'
  else
    printf 'set --\n'
  fi
}

# Combines pathspec splitting and common-flag parsing in ONE structurally
# fixed order, so every path-accepting hug command parses arguments the
# same way (uniform pathspec contract, spec §3.1).
#
# The order is NOT negotiable, and previously lived only in comments:
#   (1) consume an optional leading '--picker' mode token
#   (2) detect a trailing bare '--' and strip it
#   (3) split at the first '--' via parse_pathspecs
#   (4) delegate common-flag parsing to parse_common_flags on the pre-args
#
# WHY a helper: parse_common_flags intercepts a trailing '--' itself and
# exports HUG_INTERACTIVE_FILE_SELECTION=true. For listings that must never
# leak that export, this helper OWNS the trailing-'--' lifecycle: it strips
# the trailing '--' BEFORE parse_pathspecs can treat it as a separator, and
# re-exports HUG_INTERACTIVE_FILE_SELECTION=true ONLY when the caller passed
# '--picker' AND a trailing bare '--' was consumed. Call it without
# '--picker' and nothing is ever exported.
#
# Usage: eval "$(parse_common_flags_with_pathspecs [--picker] "$@")"
# Caller-scope effects of the eval'd output:
#   - "$@" becomes the remaining separator-free pre-args (the inner
#     parse_common_flags 'set --' applies to the CALLER's scope because
#     this helper re-establishes "$@" before delegating)
#   - _pathspec_pathspecs array is set (pathspec data after the first --)
#   - export HUG_INTERACTIVE_FILE_SELECTION=true only under the
#     --picker + trailing '--' condition described above
#
# Reserved token: '--picker' is consumed ONLY as the literal FIRST
# argument. A pathspec literally named '--picker' is unreachable before
# the separator ('hug cmd -- --picker' treats it as pathspec data, as the
# test suite verifies) — the price of an unambiguous mode token.
#
# TWO reservations, stated explicitly (doc contract, #292 review):
#   1. A trailing bare '--' is ALWAYS consumed — even for callers that do
#      NOT pass '--picker'. Non-picker callers must therefore never depend
#      on parse_common_flags' own trailing-'--' interactive trigger: this
#      helper strips the token before parse_common_flags ever sees it, so
#      HUG_INTERACTIVE_FILE_SELECTION is only ever set through the
#      '--picker' + trailing-'--' path described above.
#   2. The first-token '--picker' reservation also collides with a
#      first-positional SEARCH TERM literally named '--picker' (lc/lf/lcr
#      take the term as $1). Such a term is unreachable — 'hug lc -- --picker'
#      is a PATHSPEC named '--picker', not a term. Documented, not
#      redesigned: an unambiguous mode token cannot coexist with a
#      same-named leading positional, and no realistic search term is
#      '--picker'.
#
# NULLSAFE IDIOM (canonical form, #298): at a site where an array can be
# empty, expand it as ${arr[@]+"${arr[@]}"} — a bare "${arr[@]}" raises
# "unbound variable" under set -u on the Bash 4.0–4.3 floor this repo
# supports (docs/installation.md; fixed in Bash 4.4), and after a
# zero-line mapfile the array may be unset or empty. Sites that are
# provably non-empty (seeded at declaration, or guarded by a ${#arr[@]}
# check directly above) keep the plain form. Call sites repeat only the
# pointer, never this explanation.
#
# Pure argument surgery: performs NO git invocations, and leaves
# parse_pathspecs / parse_common_flags themselves untouched.
#
# Example:
#   parse_common_flags_with_pathspecs --dry-run HEAD -- '*.java'
#   → caller: dry_run=true, "$@"=(HEAD), _pathspec_pathspecs=('*.java')
parse_common_flags_with_pathspecs() {
  local picker_mode=false
  if [[ "${1:-}" == "--picker" ]]; then
    picker_mode=true
    shift
  fi

  local trailing_picker=false
  if [[ $# -gt 0 && "${!#}" = "--" ]]; then
    $picker_mode && trailing_picker=true
    set -- "${@:1:$(($# - 1))}"
  fi

  # Split at the first '--' (function-local; re-emitted for the caller below)
  eval "$(parse_pathspecs "$@")"

  {
    # Restore pre-args as the caller's "$@", then delegate common-flag parsing
    # (its 'set --' therefore applies to the CALLER's scope).
    printf 'set -- '
    if [[ ${#_pathspec_pre_args[@]} -gt 0 ]]; then
      printf '%q ' "${_pathspec_pre_args[@]}"
    fi
    printf '\n'
    # shellcheck disable=SC2016
    # WHY single quotes: the text must survive to the caller's eval unexpanded —
    # the caller's "$@", not this function's, is what parse_common_flags must see.
    printf 'eval "$(parse_common_flags "$@")"\n'

    printf '_pathspec_pathspecs=('
    if [[ ${#_pathspec_pathspecs[@]} -gt 0 ]]; then
      printf ' %q' "${_pathspec_pathspecs[@]}"
    fi
    printf ' )\n'

    if $trailing_picker; then
      printf 'export HUG_INTERACTIVE_FILE_SELECTION=true\n'
    fi
  }
}

# Accessor for the collected pathspecs (#298): downstream modules read the
# split through this function instead of touching the _pathspec_pathspecs
# global directly — one read path, so the representation can change later.
#
# Usage: pathspec_pathspecs_into <nameref>
# Effects:
#   Assigns the caller-named array variable to the current contents of
#   _pathspec_pathspecs (empty array when none were collected). Works from
#   any sourced module in the same shell — the global is shell-wide.
#
# Reserved prefix __psx_ — a caller variable with this name circulars the
# nameref (documented; Bash >= 4.3, same floor as the 107 existing
# local -n uses in git-config/lib).
pathspec_pathspecs_into() {
  local -n __psx_out="$1"
  # ${arr[@]+x} guard: under set -u an UNSET global (helper used before any
  # parse — the exact cross-module case) must not kill the shell.
  __psx_out=(${_pathspec_pathspecs[@]+"${_pathspec_pathspecs[@]}"})
}

# Picker-forwarding helper (#298): the ONE place that appends the collected
# pathspecs to a picker's option array behind a protective '--' — a pathspec
# literally named like a picker option ('--staged') must stay data, and a
# missing pathspec list must never leave a bare '--'. Replaces the idiom
# previously repeated across hug-select-files, hug-git-diff, lc/lf/lcr.
#
# Usage: forward_pathspecs_to_picker <select_opts_nameref>
# Effects:
#   Appends nothing when no pathspecs were collected; exactly
#   '--' <pathspec...> when some were. Pure argument/array surgery — no git.
#   Call at most ONCE per opts array: a second call would append a second
#   '--' <pathspecs> group (harmless to most pickers, but not idempotent).
#
# Post-pick rule (part of this contract): the picked file REPLACES the
# user's pathspecs on the exec line that follows a selection — git unions
# positive pathspecs, so keeping both would widen the scope back out. The
# pathspecs' job ends at scoping the picker candidates.
forward_pathspecs_to_picker() {
  # Reserved prefix __fps_ — see pathspec_pathspecs_into's note.
  local -n __fps_opts="$1"
  # ${arr[*]+x} probe ([*], not [@]: shellcheck SC2199; identical set-ness
  # for a +x test): under set -u an UNSET global (helper used before any
  # parse — the exact cross-module case) must not kill the shell.
  if [[ ${_pathspec_pathspecs[*]+x} && ${#_pathspec_pathspecs[@]} -gt 0 ]]; then
    __fps_opts+=("--" ${_pathspec_pathspecs[@]+"${_pathspec_pathspecs[@]}"})
  fi
}

# Post-separator drain (#292 PR-B Task 7): the `--)` arm of a
# separator-aware option loop. The caller has MATCHED '--', so every
# remaining token is verbatim pathspec DATA — even one spelled like the
# loop's own flags (a file literally named '--cwd' must scope the query,
# not toggle the scope flag). Extracted from the inner-while drain
# copy-pasted across output_json_status, output_json_status_unified,
# collect_git_files_json (hug-git-json), the selector loops in
# hug-select-files, and the five list_*_files arms in hug-git-files —
# ONE named contract instead of ten clones; an eleventh copy would have
# been one more place to forget the break. All sites adopted.
#
# Usage (inside the option loop's `--)` arm — the shift+break are the
# CALLER's job: this helper cannot consume the caller's "$@", a function
# only ever sees a copy):
#   --)
#     shift                                # consume the separator itself
#     drain_pathspecs_after_separator pathspecs "$@"
#     break                                # the rest is data — stop parsing
#     ;;
#
# Pure argument surgery: appends its arguments to the nameref'd array, no
# git, no output, no separator re-emission (the exact-one-'--' rule is the
# CALLER's: this layer CONSUMES the separator it matched and the next
# boundary re-appends exactly one — see output_json_status).
drain_pathspecs_after_separator() {
  # Reserved prefix __dps_ — see pathspec_pathspecs_into's nameref note
  # (Bash >= 4.3 floor, same as the existing local -n uses).
  local -n __dps_out="$1"
  shift
  __dps_out+=("$@")
}

# Count LEADING positional arguments only — the first flag-looking token
# ends the count (#298). Cardinality guards (llf, stats-file, ...) use this
# so a flag's separate-word VALUE is never miscounted as a second file
# ('llf a --staged' has ONE file, not two — the PR-A regression this
# idiom encodes). '--' itself ends the count: post-'--' tokens are
# pathspec data, not command positionals.
#
# Usage: count_positional_args_before_flags [args...]
# Parameters:
#   $@ - Raw CLI args to scan (safe to pass an empty/unset-arg list)
# Effects:
#   Prints the count of leading non-'-*' args to stdout. Pure computation:
#   no git, no exit on any input. Callers capture via $(...) — command
#   substitution strips the trailing newline, so the result is a clean
#   integer even under 'set -euo pipefail'.
count_positional_args_before_flags() {
  local n=0 arg
  for arg in "$@"; do
    case "$arg" in
    -*) break ;;
    *) n=$((n + 1)) ;;
    esac
  done
  printf '%s\n' "$n"
}

# Cardinality guard for single-file commands (spec §3.2 / §5.6 of the
# pathspec-contract design). Rejects more than one file argument with a
# clear, command-naming error instead of git's raw fatals or silent ignores.
#
# Usage: reject_multiple_files "<cmd-name>" [file...]
# Parameters:
#   $1 - Command name for the error message (e.g. "hug fa")
#   $@ - Remaining args are the candidate file arguments
# Note:
#   Empty-string arguments are ignored (not counted as files), so callers
#   can pass through optional-position variables without pre-filtering.
# Effects:
#   Exits with error if more than one non-empty file argument is given
reject_multiple_files() {
  local cmd_name="$1"; shift
  local -a files=()
  local f
  for f in "$@"; do
    [[ -n "$f" ]] && files+=("$f")
  done
  if [[ ${#files[@]} -gt 1 ]]; then
    # error_usage (exit 2, code-roast alignment): a cardinality violation
    # is a USAGE error — the migrated pathspec family rejects unknown
    # options with the same code; exit 1 made scripts unable to
    # distinguish "bad invocation" from "command failed".
    error_usage "${cmd_name} accepts only one file."
  fi
}

# reject_action_flags <cmd-name> — for LISTING commands whose only common
# flags are -q and help (codex P2 on statusbase): parse_common_flags happily
# consumes -f/--force, -y/--yes, --dry-run and --browse-root, so a listing
# would silently accept an action flag and print a normal unscoped listing —
# the exact silent-accept class this contract exists to kill. Call it
# immediately after 'eval "$(parse_common_flags_with_pathspecs ...)"': the
# eval'd assignments (dry_run/force/browse_root/yes_flag) are visible at the
# caller's scope. yes_flag, NOT HUG_YES: the export may be inherited from the
# environment (sequence automation exports it for a whole hug command line),
# and inherited state must not reject an innocent listing (codex P2).
# Action commands (us, a, ...) must NOT call this — those flags are their
# contract.
reject_action_flags() {
  if ${dry_run:-false} || ${force:-false} || ${browse_root:-false} || ${yes_flag:-false}; then
    # error_usage: exit 2, the usage-error family code (unknown dash-tokens,
    # malformed pathspecs, cardinality violations).
    error_usage "$1 is a listing: action flags (-f/--force, -y/--yes, --dry-run, --browse-root) do not apply. See 'hug help :pathspec'."
  fi
}

# Validates minimum number of arguments
# Usage: require_args N ["error message"]
# Parameters:
#   $1 - Minimum number of arguments required
#   $2 - (Optional) Custom error message
# Environment:
#   Uses $# from caller's context
# Note:
#   This is meant to be called with: require_args N "$#" ["message"]
require_args() {
  local required="$1"
  local actual="$2"
  local message="${3:-this command requires at least $required argument(s)}"
  
  if [[ $actual -lt $required ]]; then
    error "$message"
  fi
}

# Checks that --browse-root is not used with explicit paths
# Usage: check_browse_root_no_paths browse_root_flag has_paths
# Parameters:
#   $1 - Boolean value of browse_root flag
#   $2 - Boolean indicating if paths are provided (true if $# > 0 after flag parsing)
# Effects:
#   Exits with error if browse_root is true and paths are provided
check_browse_root_no_paths() {
  local browse_root="$1"
  local has_paths="$2"
  
  if $browse_root && $has_paths; then
    error "--browse-root cannot be used with explicit paths. Either use --browse-root alone to browse files, or specify paths directly."
  fi
}

